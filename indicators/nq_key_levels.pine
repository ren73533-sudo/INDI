//@version=6
indicator("INDI · NQ Key Levels & Reversal Zones [v0.2]", "INDI NQ", overlay = true, max_lines_count = 500, max_boxes_count = 200, max_labels_count = 400, max_bars_back = 500)

// Strategy requirements: docs/GPT-HANDOFF.md. Implementation decisions: docs/DECISIONS.md.
// Display only. No orders, alerts, directional filter or entry signals.
// Confirmed HTF requests use past candles + lookahead_on, never a developing HTF candle.

const string G_CORE = "01 · Calibrage / confluences"
const string G_FIB = "02 · Fib STDV · corps uniquement"
const string G_VWAP = "03 · VWAP / écarts-types"
const string G_VP = "04 · Profil de volume estimé"
const string G_RB = "05 · Rejection Blocks confirmés"
const string G_VIEW = "06 · Affichage"
const string G_COL = "07 · Couleurs"
const int DAY_MS = 86400000

float tolerance = input.float(15.0, "Tolérance POI (points)", minval = 5, maxval = 50, step = 0.25, group = G_CORE)
bool distinctKinds = input.bool(true, "Exiger des types de concepts distincts", tooltip = "ON : Fib + VWAP, par exemple. Deux Fib ou deux RB restent un seul type. OFF : deux niveaux suffisent.", group = G_CORE)
int minimumConcepts = input.int(2, "Minimum de concepts / niveaux", minval = 2, maxval = 4, group = G_CORE)
float invalidation = input.float(15.0, "Invalidation par dépassement (points)", minval = 0.25, maxval = 100, step = 0.25, tooltip = "Une résistance meurt si high >= son sommet + distance ; un support si low <= sa base - distance. Aucune clôture requise.", group = G_CORE)
bool invalidateMoving = input.bool(true, "Invalider aussi VWAP / profil jusqu'au prochain ancrage", tooltip = "Test sur le dernier niveau connu avant la bougie. Un niveau mobile invalidé reste exclu des POI jusqu'au reset de sa session / journée. OFF : ces niveaux restent des références mobiles permanentes.", group = G_CORE)
int maxPoi = input.int(15, "Maximum de zones POI affichées", minval = 1, maxval = 30, group = G_CORE)
float poiPadding = input.float(0.5, "Marge visuelle des POI (points)", minval = 0, maxval = 10, step = 0.25, tooltip = "Affichage seulement : ne change ni la confluence ni l'invalidation.", group = G_CORE)

bool useFib = input.bool(true, "Activer les Fib dans les confluences", group = G_FIB)
string fibTf = input.timeframe("5", "Bougies de construction", options = ["1", "5", "15"], tooltip = "5 min par défaut, comme le prototype. Le choix change les corps et donc les ancrages. Le graphique doit être en 1 min ou 5 min et ne pas dépasser cette unité.", group = G_FIB)
string fibWindow = input.session("0000-0730", "Fenêtre fixe UTC", tooltip = "Fenêtre dans une seule journée, sans passage de minuit. Les deux bornes doivent être alignées sur les bougies de construction.", group = G_FIB)
string expansionMode = input.string("Ensemble", "Armement ±3 / ±3.5 / ±4", options = ["Ensemble", "Par signe"], tooltip = "Ensemble : une clôture hors de [-2.5, +2.5] arme les deux bandes. Par signe : chaque signe s'arme séparément. Clôture de l'unité du graphique.", group = G_FIB)
bool showFib = input.bool(true, "Afficher les niveaux individuels", group = G_FIB)
bool showGeometry = input.bool(false, "Afficher 0 / 1 / 1.5 (contexte uniquement)", group = G_FIB)
bool showDormant = input.bool(false, "Afficher l'expansion dormante en gris", group = G_FIB)
bool showPrevious = input.bool(true, "Afficher les Fib de la série précédente", tooltip = "Reste actif dans le moteur même si masqué. Seules les deux dernières séries publiées sont conservées.", group = G_FIB)
string fibRetention = input.string("Séance précédente", "Conservation des Fib", options = ["Séance précédente", "Jour calendaire précédent"], tooltip = "Séance précédente (défaut v0.2) : on garde les deux dernières séries RÉELLEMENT publiées, donc vendredi reste visible le lundi. Jour calendaire précédent : comportement v0.1, une série de plus de 24 h est supprimée même si aucune autre n'a été publiée depuis.", group = G_FIB)

bool useVwap = input.bool(true, "Activer VWAP ±2 / ±3 dans les confluences", group = G_VWAP)
string vwapAnchor = input.string("Futures 22:00 UTC", "Ancrage", options = ["Futures 22:00 UTC", "Futures CME 18:00 New York", "RTH New York", "Jour UTC", "Heure UTC personnalisée"], group = G_VWAP)
int vwapHour = input.int(22, "Heure UTC personnalisée", minval = 0, maxval = 23, group = G_VWAP, inline = "anchor")
int vwapMinute = input.int(0, "Minute", minval = 0, maxval = 59, group = G_VWAP, inline = "anchor")
bool rthOnly = input.bool(true, "RTH : accumuler seulement 09:30–16:00 New York", tooltip = "Les heures RTH suivent le DST américain. Les autres ancrages accumulent toutes les bougies disponibles.", group = G_VWAP)
int vwapWarmup = input.int(5, "Attendre avant d'activer les bandes (minutes)", minval = 1, maxval = 120, group = G_VWAP)
bool showVwap = input.bool(true, "Afficher les références VWAP", group = G_VWAP)
bool showVwapCurve = input.bool(true, "Tracer les courbes VWAP / bandes", group = G_VWAP)
bool showSd1 = input.bool(false, "Afficher ±1 SD (contexte uniquement)", group = G_VWAP)

bool useVp = input.bool(true, "Activer VAH / VAL dans les confluences", group = G_VP)
int vpTicks = input.int(20, "Taille d'une ligne (ticks)", minval = 1, maxval = 400, tooltip = "NQ : 20 ticks = 5 points. Volume réparti uniformément sur high–low : estimation, pas volume réel à chaque prix.", group = G_VP)
float valueArea = input.float(70, "Value area (%)", minval = 50, maxval = 95, step = 1, group = G_VP)
int vpMaxRows = input.int(600, "Limite de lignes (protection performance)", minval = 50, maxval = 2000, tooltip = "Si la journée dépasse la capacité, le profil est déclaré indisponible. Augmenter la taille de ligne ou la limite ; aucune troncature silencieuse.", group = G_VP)
int vpWarmup = input.int(15, "Attendre avant d'activer le profil (minutes UTC)", minval = 1, maxval = 240, group = G_VP)
bool includePoc = input.bool(false, "Compter POC dans les confluences", tooltip = "OFF par défaut : POC est une référence d'absorption / contexte, pas un niveau d'entrée défini par la stratégie.", group = G_VP)
bool showVp = input.bool(true, "Afficher VAH / VAL / POC", group = G_VP)

bool useRb = input.bool(true, "Activer les RB dans les confluences", group = G_RB)
bool rb5 = input.bool(true, "5 min", group = G_RB, inline = "tf")
bool rb10 = input.bool(true, "10 min", group = G_RB, inline = "tf")
bool rb15 = input.bool(true, "15 min", group = G_RB, inline = "tf")
float wickBodyRatio = input.float(2.0, "Mèche ≥ N × corps", minval = 0.5, maxval = 10, step = 0.1, group = G_RB)
float wickPercent = input.float(60, "Mèche ≥ % de la bougie", minval = 10, maxval = 95, step = 1, group = G_RB)
int leadBars = input.int(2, "Impulsion préalable : recul en bougies", minval = 1, maxval = 10, tooltip = "Hausse / baisse nette des clôtures précédant la bougie de rejet. Définition de travail configurable, à comparer à tes RB manuels.", group = G_RB)
string rbConfirm = input.string("Corps", "Clôture de confirmation au-delà du", options = ["Corps", "Extrême"], tooltip = "La bougie immédiatement suivante doit inverser sa couleur et clôturer au-delà du corps (défaut) ou de l'extrême du rejet. Le RB n'est disponible qu'après cette confirmation.", group = G_RB)
int rbLimit = input.int(40, "Maximum de RB conservés", minval = 5, maxval = 100, group = G_RB)
int rbMaxDays = input.int(0, "Expiration en jours (0 = aucune)", minval = 0, maxval = 30, group = G_RB)
bool showRb = input.bool(true, "Afficher les zones de mèche", group = G_RB)

bool showLabels = input.bool(true, "Étiquettes avec prix", group = G_VIEW)
bool showDashboard = input.bool(true, "Tableau d'état", group = G_VIEW)
bool persistFib = input.bool(false, "Tracer les Fib principaux dans l'historique", tooltip = "VALIDATION. Tout le reste n'est dessiné que sur la dernière bougie : sans ceci, impossible de remonter à une matinée annotée sans Bar Replay. Trace ±2 / ±2.25 / ±2.5 de chaque jour publié, de leur naissance à la fin de leur journée UTC. Les niveaux dormants, VWAP, profil et POI restent hors historique : ils se recalculent et les figer suggérerait des signaux rétrospectifs.", group = G_VIEW)
int persistDays = input.int(40, "Jours de Fib historiques conservés", minval = 1, maxval = 80, tooltip = "6 lignes par jour. Au-delà, les plus anciennes sont supprimées pour rester sous la limite d'objets de TradingView.", group = G_VIEW)
bool showDead = input.bool(false, "Afficher aussi les niveaux invalidés en gris", group = G_VIEW)
int extendBars = input.int(35, "Projection à droite (bougies)", minval = 5, maxval = 250, group = G_VIEW)
int labelSpacing = input.int(0, "Décalage entre étiquettes (bougies)", minval = 0, maxval = 3, group = G_VIEW)
int lineWidth = input.int(1, "Épaisseur des niveaux", minval = 1, maxval = 4, group = G_VIEW)
string linePattern = input.string("Pointillés", "Style des niveaux", options = ["Continu", "Tirets", "Pointillés"], group = G_VIEW)
string fontChoice = input.string("Petit", "Taille des textes", options = ["Petit", "Normal", "Grand"], group = G_VIEW)
int poiOpacity = input.int(82, "Transparence POI (0 = opaque)", minval = 0, maxval = 100, group = G_VIEW)
int rbOpacity = input.int(91, "Transparence RB", minval = 0, maxval = 100, group = G_VIEW)

color fibTodayColor = input.color(#f5c542, "Fib du jour", group = G_COL)
color fibPrevColor = input.color(#b896e8, "Fib du jour précédent", group = G_COL)
color vwapColor = input.color(#d9e1ec, "VWAP centrale / ±1", group = G_COL)
color sd2Color = input.color(#33bbff, "VWAP ±2", group = G_COL)
color sd3Color = input.color(#3978ee, "VWAP ±3", group = G_COL)
color vahColor = input.color(#ff9c52, "VAH", group = G_COL)
color valColor = input.color(#50c997, "VAL", group = G_COL)
color pocColor = input.color(#df80bf, "POC", group = G_COL)
color rbUpperColor = input.color(#d87960, "RB mèche haute", group = G_COL)
color rbLowerColor = input.color(#70b6a0, "RB mèche basse", group = G_COL)
color poiAboveColor = input.color(#ef6c76, "POI au-dessus du prix", group = G_COL)
color poiBelowColor = input.color(#38c5a0, "POI sous le prix", group = G_COL)
color poiAtPriceColor = input.color(#e3bd54, "POI au prix", group = G_COL)
color inactiveColor = input.color(#747b88, "Dormant / invalidé", group = G_COL)
color textColor = input.color(#edf2f7, "Texte", group = G_COL)
color panelColor = input.color(#18212d, "Fond du tableau", group = G_COL)

// kind: 1 Fib, 2 VWAP, 3 volume profile, 4 RB. side: +1 resistance, -1 support.
type Level
    float lo
    float hi
    int kind
    string caption
    int born
    int epoch
    int side
    bool active
    bool dead
    float multiplier
    float p0
    float leg

type Poi
    float lo
    float hi
    int kinds
    int members
    string details
    array<int> memberIds

f_day(int t) =>
    timestamp("UTC", year(t, "UTC"), month(t, "UTC"), dayofmonth(t, "UTC"), 0, 0)

f_side(float p, float reference) =>
    p >= reference ? 1 : -1

f_level(float lo, float hi, int kind, string caption, int born, int epoch, int side) =>
    Level.new(lo, hi, kind, caption, born, epoch, side, true, false, na, na, na)

f_breached(Level level) =>
    level.side == 1 ? high >= level.hi + invalidation : low <= level.lo - invalidation

f_font() =>
    fontChoice == "Grand" ? size.large : fontChoice == "Normal" ? size.normal : size.small

f_style() =>
    linePattern == "Continu" ? line.style_solid : linePattern == "Tirets" ? line.style_dashed : line.style_dotted

int rangeStart = int(str.tonumber(str.substring(fibWindow, 0, 2))) * 60 + int(str.tonumber(str.substring(fibWindow, 2, 4)))
int rangeEnd = int(str.tonumber(str.substring(fibWindow, 5, 7))) * 60 + int(str.tonumber(str.substring(fibWindow, 7, 9)))
float chartSeconds = timeframe.in_seconds()
float fibSeconds = timeframe.in_seconds(fibTf)
if barstate.isfirst
    if not chart.is_standard or not timeframe.isintraday or (chartSeconds != 60 and chartSeconds != 300)
        runtime.error("V0.1 : utiliser des bougies standard en 1 min (recommandé) ou 5 min. Les RB sont calculés séparément en 5 / 10 / 15 min.")
    if chartSeconds > fibSeconds
        runtime.error("L'unité du graphique doit être inférieure ou égale à l'unité de construction Fib.")
    if rangeEnd <= rangeStart or (rangeStart * 60) % int(fibSeconds) != 0 or (rangeEnd * 60) % int(fibSeconds) != 0
        runtime.error("La fenêtre Fib doit rester dans une journée UTC et ses bornes doivent s'aligner sur l'unité de construction.")

// A source bar must close before its body is used. All output fields are offset by 1.
// Equal extremes keep their FIRST occurrence; both extremes on the same bar are ambiguous.
f_range() =>
    var int day = na
    var float hi = na
    var float lo = na
    var int hiTime = na
    var int loTime = na
    var bool completeStart = false
    var bool ready = false
    var float p0 = na
    var float p1 = na
    int d = f_day(time)
    int m = hour(time, "UTC") * 60 + minute(time, "UTC")
    if na(day) or d != day
        day := d
        hi := na
        lo := na
        hiTime := na
        loTime := na
        completeStart := false
        ready := false
        p0 := na
        p1 := na
    if m >= rangeStart and m < rangeEnd
        float bh = math.max(open, close)
        float bl = math.min(open, close)
        if na(hi) or bh > hi
            hi := bh
            hiTime := time
        if na(lo) or bl < lo
            lo := bl
            loTime := time
        completeStart := completeStart or m == rangeStart
        if time_close == d + rangeEnd * 60000 and completeStart and hi > lo and hiTime != loTime
            p0 := hiTime < loTime ? hi : lo
            p1 := hiTime < loTime ? lo : hi
            ready := true
    [p0[1], p1[1], day[1], ready[1]]

[range0, range1, rangeDay, rangeReady] = request.security(syminfo.tickerid, fibTf, f_range(), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)

var array<Level> fibs = array.new<Level>()
var array<int> fibEpochs = array.new_int()
var array<line> staticLines = array.new<line>()
var int publishedDay = na
var float today0 = na
var float today1 = na
int utcDay = f_day(time)
bool newDay = barstate.isfirst or utcDay != utcDay[1]
// v0.2: retention counts PUBLISHED series, not elapsed calendar days. A calendar
// purge deletes Friday during the weekend, so Monday opens with no previous set
// at all — one trading day in five running a concept short.
bool calendarRetention = fibRetention == "Jour calendaire précédent"
if newDay
    today0 := na
    today1 := na
    if calendarRetention
        int i = array.size(fibs) - 1
        while i >= 0
            if array.get(fibs, i).epoch < utcDay - DAY_MS
                array.remove(fibs, i)
            i -= 1
        while array.size(fibEpochs) > 0 and array.get(fibEpochs, 0) < utcDay - DAY_MS
            array.shift(fibEpochs)

if rangeReady and rangeDay == utcDay and (na(publishedDay) or publishedDay != rangeDay)
    today0 := range0
    today1 := range1
    publishedDay := rangeDay
    array<float> multipliers = array.from(2.0, 2.25, 2.5, -2.0, -2.25, -2.5, 3.0, 3.5, 4.0, -3.0, -3.5, -4.0)
    for multiplier in multipliers
        float price = range0 + multiplier * (range1 - range0)
        string signedName = (multiplier > 0 ? "+" : "") + str.tostring(multiplier, "#.##")
        Level level = f_level(price, price, 1, signedName, utcDay + rangeEnd * 60000, utcDay, f_side(price, open))
        level.multiplier := multiplier
        level.p0 := range0
        level.leg := range1 - range0
        level.active := math.abs(multiplier) <= 2.5
        array.push(fibs, level)
        // Static trace: primaries only. Expansion arms later, so drawing it at
        // birth would show a level that was not yet available that morning.
        if persistFib and level.active
            array.push(staticLines, line.new(level.born, price, utcDay + DAY_MS, price, xloc = xloc.bar_time, color = color.new(fibTodayColor, 35), style = f_style(), width = lineWidth))
    if not array.includes(fibEpochs, utcDay)
        array.push(fibEpochs, utcDay)
    if not calendarRetention
        while array.size(fibEpochs) > 2
            int stale = array.shift(fibEpochs)
            int k = array.size(fibs) - 1
            while k >= 0
                if array.get(fibs, k).epoch == stale
                    array.remove(fibs, k)
                k -= 1
    while array.size(staticLines) > persistDays * 6
        line.delete(array.shift(staticLines))

for level in fibs
    bool justArmed = false
    if not level.active and not level.dead and barstate.isconfirmed
        float coordinate = (close - level.p0) / level.leg
        bool crossed = expansionMode == "Ensemble" ? (coordinate > 2.5 or coordinate < -2.5) : (level.multiplier > 0 ? coordinate > 2.5 : coordinate < -2.5)
        if crossed
            level.active := true
            level.side := f_side(level.lo, close)
            justArmed := true
    if level.active and not level.dead and not justArmed and f_breached(level)
        level.dead := true

// Weighted Welford variance avoids cancellation in E[x²] - E[x]² at NQ price scale.
f_anchor(string tz, int h, int m) =>
    int localMinute = hour(time, tz) * 60 + minute(time, tz)
    int dayOffset = localMinute < h * 60 + m ? -1 : 0
    timestamp(tz, year(time, tz), month(time, tz), dayofmonth(time, tz) + dayOffset, h, m)

int anchorKey = switch vwapAnchor
    "Futures CME 18:00 New York" => f_anchor("America/New_York", 18, 0)
    "RTH New York" => f_anchor("America/New_York", 9, 30)
    "Jour UTC" => utcDay
    "Heure UTC personnalisée" => f_anchor("UTC", vwapHour, vwapMinute)
    => f_anchor("UTC", 22, 0)
bool inRth = not na(time(timeframe.period, "0930-1600:23456", "America/New_York"))
bool accumulateVwap = vwapAnchor != "RTH New York" or not rthOnly or inRth
var int vwapEpoch = na
var float weight = 0.0
var float mean = na
var float m2 = 0.0
var bool vwapComplete = false
var array<Level> vwapLevels = array.new<Level>()
if accumulateVwap
    if na(vwapEpoch) or anchorKey != vwapEpoch
        vwapEpoch := anchorKey
        weight := 0.0
        mean := na
        m2 := 0.0
        // An anchor can fall in a legitimate exchange closure (e.g. fixed 22:00
        // UTC during winter CME maintenance). A loaded bar before the boundary
        // proves we did not simply start the dataset midway through the session.
        vwapComplete := time == anchorKey or (not na(time_close[1]) and time_close[1] <= anchorKey)
        array.clear(vwapLevels)
    if not na(volume) and volume > 0
        float newWeight = weight + volume
        float delta = na(mean) ? 0.0 : hlc3 - mean
        float newMean = na(mean) ? hlc3 : mean + volume / newWeight * delta
        m2 += volume * delta * (hlc3 - newMean)
        mean := newMean
        weight := newWeight
float deviation = weight > 0 ? math.sqrt(math.max(m2 / weight, 0.0)) : na
bool vwapReady = accumulateVwap and vwapComplete and weight > 0 and deviation >= syminfo.mintick and time_close >= vwapEpoch + vwapWarmup * 60000
array<float> vwapPrices = array.from(mean + 2 * deviation, mean - 2 * deviation, mean + 3 * deviation, mean - 3 * deviation)
if vwapReady and array.size(vwapLevels) == 0
    array<string> names = array.from("VWAP +2 SD", "VWAP -2 SD", "VWAP +3 SD", "VWAP -3 SD")
    for i = 0 to 3
        float price = array.get(vwapPrices, i)
        array.push(vwapLevels, f_level(price, price, 2, array.get(names, i), time_close, vwapEpoch, f_side(price, close)))
else if vwapReady
    for i = 0 to array.size(vwapLevels) - 1
        Level level = array.get(vwapLevels, i)
        if invalidateMoving and f_breached(level)
            level.dead := true
        level.lo := array.get(vwapPrices, i)
        level.hi := level.lo
        if not invalidateMoving
            level.side := f_side(level.lo, close)

// Fixed tick-aligned buckets; no rebucketing errors when the daily range expands.
// Only the final visible UTC day is profiled, including all its available bars.
var array<float> profile = array.new_float()
var int baseRow = na
var bool vpOverflow = false
var bool vpComplete = false
var float profileVolume = 0.0
var array<Level> vpLevels = array.new<Level>()
float rowSize = vpTicks * syminfo.mintick
bool profileDay = utcDay == f_day(last_bar_time)
if newDay
    array.clear(profile)
    array.clear(vpLevels)
    baseRow := na
    vpOverflow := false
    vpComplete := time == utcDay or (not na(time_close[1]) and time_close[1] <= utcDay)
    profileVolume := 0.0
if profileDay and not vpOverflow and not na(volume) and volume > 0
    int bottomRow = int(math.floor(low / rowSize))
    int topRow = int(math.floor(high / rowSize))
    int nextBase = na(baseRow) ? bottomRow : math.min(baseRow, bottomRow)
    int nextTop = na(baseRow) ? topRow : math.max(baseRow + array.size(profile) - 1, topRow)
    if nextTop - nextBase + 1 > vpMaxRows
        vpOverflow := true
        array.clear(vpLevels)
    else
        if na(baseRow)
            baseRow := bottomRow
        while baseRow > nextBase
            array.unshift(profile, 0.0)
            baseRow -= 1
        while array.size(profile) < nextTop - baseRow + 1
            array.push(profile, 0.0)
        for row = bottomRow to topRow
            float overlap = math.max(0.0, math.min(high, (row + 1) * rowSize) - math.max(low, row * rowSize))
            float allocated = high == low ? volume : volume * overlap / (high - low)
            int index = row - baseRow
            array.set(profile, index, array.get(profile, index) + allocated)
        profileVolume += volume

bool vpReady = profileDay and vpComplete and not vpOverflow and profileVolume > 0 and time_close >= utcDay + vpWarmup * 60000
float poc = na
float vah = na
float val = na
if vpReady
    float peak = -1.0
    int pocIndex = 0
    for i = 0 to array.size(profile) - 1
        float v = array.get(profile, i)
        if v > peak
            peak := v
            pocIndex := i
    int left = pocIndex
    int right = pocIndex
    float captured = peak
    float target = profileVolume * valueArea / 100.0
    while captured < target and (left > 0 or right < array.size(profile) - 1)
        float lv = left > 0 ? array.get(profile, left - 1) : -1.0
        float rv = right < array.size(profile) - 1 ? array.get(profile, right + 1) : -1.0
        if lv >= rv and left > 0
            left -= 1
            captured += lv
        if rv >= lv and right < array.size(profile) - 1
            right += 1
            captured += rv
    poc := (baseRow + pocIndex + 0.5) * rowSize
    vah := (baseRow + right + 1) * rowSize
    val := (baseRow + left) * rowSize
    array<float> prices = array.from(vah, val, poc)
    if array.size(vpLevels) == 0
        array<string> names = array.from("VAH ~", "VAL ~", "POC ~")
        for i = 0 to 2
            float price = array.get(prices, i)
            array.push(vpLevels, f_level(price, price, 3, array.get(names, i), time_close, utcDay, f_side(price, close)))
    else
        for i = 0 to 2
            Level level = array.get(vpLevels, i)
            if invalidateMoving and f_breached(level)
                level.dead := true
            level.lo := array.get(prices, i)
            level.hi := level.lo
            if not invalidateMoving
                level.side := f_side(level.lo, close)

// Rejecting candle [2], immediately following reversal [1]. A doji body is floored
// at one tick for the wick/body test. No pivots and no BOS prerequisite.
f_rb() =>
    float bodyHi = math.max(open[2], close[2])
    float bodyLo = math.min(open[2], close[2])
    float body = math.max(bodyHi - bodyLo, syminfo.mintick)
    float span = high[2] - low[2]
    float upper = high[2] - bodyHi
    float lower = bodyLo - low[2]
    bool upMove = close[3] > close[3 + leadBars]
    bool downMove = close[3] < close[3 + leadBars]
    bool rejectHigh = span > 0 and upper >= wickBodyRatio * body and upper >= span * wickPercent / 100.0
    bool rejectLow = span > 0 and lower >= wickBodyRatio * body and lower >= span * wickPercent / 100.0
    bool reverseDown = close[1] < open[1] and close[1] < (rbConfirm == "Corps" ? bodyLo : low[2])
    bool reverseUp = close[1] > open[1] and close[1] > (rbConfirm == "Corps" ? bodyHi : high[2])
    bool upperRb = upMove and rejectHigh and reverseDown and high[1] < high[2] + invalidation
    bool lowerRb = downMove and rejectLow and reverseUp and low[1] > low[2] - invalidation
    float zLo = upperRb ? bodyHi : lowerRb ? low[2] : na
    float zHi = upperRb ? high[2] : lowerRb ? bodyLo : na
    int side = upperRb ? 1 : lowerRb ? -1 : 0
    [zLo, zHi, side, time[2]]

[rbLo5, rbHi5, rbSide5, rbTime5] = request.security(syminfo.tickerid, "5", f_rb(), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
[rbLo10, rbHi10, rbSide10, rbTime10] = request.security(syminfo.tickerid, "10", f_rb(), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
[rbLo15, rbHi15, rbSide15, rbTime15] = request.security(syminfo.tickerid, "15", f_rb(), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
var array<Level> rbs = array.new<Level>()
var array<int> seenRb = array.new_int(3, 0)
var int evictedRb = 0
array<float> rbLows = array.from(rbLo5, rbLo10, rbLo15)
array<float> rbHighs = array.from(rbHi5, rbHi10, rbHi15)
array<int> rbSides = array.from(rbSide5, rbSide10, rbSide15)
array<int> rbTimes = array.from(rbTime5, rbTime10, rbTime15)
array<bool> enabledRb = array.from(rb5, rb10, rb15)
array<string> rbNames = array.from("RB 5m", "RB 10m", "RB 15m")
for i = 0 to 2
    int stamp = array.get(rbTimes, i)
    if array.get(enabledRb, i) and array.get(rbSides, i) != 0 and not na(stamp) and stamp != array.get(seenRb, i)
        array.set(seenRb, i, stamp)
        array.push(rbs, f_level(array.get(rbLows, i), array.get(rbHighs, i), 4, array.get(rbNames, i), time, stamp, array.get(rbSides, i)))
for level in rbs
    if not level.dead and f_breached(level)
        level.dead := true
int rbIndex = array.size(rbs) - 1
while rbIndex >= 0
    Level level = array.get(rbs, rbIndex)
    bool expired = rbMaxDays > 0 and time - level.epoch >= rbMaxDays * DAY_MS
    if expired or (level.dead and not showDead)
        array.remove(rbs, rbIndex)
    rbIndex -= 1
while array.size(rbs) > rbLimit
    array.shift(rbs)
    evictedRb += 1

// Curves are CONTEXT: invalidated bands may remain visible but cannot enter POIs.
bool curveVisible = showVwap and showVwapCurve and vwapComplete and accumulateVwap
bool anchorChanged = vwapEpoch != vwapEpoch[1]
plot(curveVisible and not anchorChanged ? mean : na, "VWAP hlc3", color = vwapColor, linewidth = 2, style = plot.style_linebr)
plot(curveVisible and not anchorChanged ? mean + 2 * deviation : na, "VWAP +2 SD contexte", color = sd2Color, style = plot.style_linebr)
plot(curveVisible and not anchorChanged ? mean - 2 * deviation : na, "VWAP -2 SD contexte", color = sd2Color, style = plot.style_linebr)
plot(curveVisible and not anchorChanged ? mean + 3 * deviation : na, "VWAP +3 SD contexte", color = sd3Color, style = plot.style_linebr)
plot(curveVisible and not anchorChanged ? mean - 3 * deviation : na, "VWAP -3 SD contexte", color = sd3Color, style = plot.style_linebr)
plot(curveVisible and showSd1 and not anchorChanged ? mean + deviation : na, "VWAP +1 SD non tradé", color = color.new(vwapColor, 65), style = plot.style_linebr)
plot(curveVisible and showSd1 and not anchorChanged ? mean - deviation : na, "VWAP -1 SD non tradé", color = color.new(vwapColor, 65), style = plot.style_linebr)

// Render the current state only. No historic POI boxes suggesting retrospective signals.
var array<line> drawnLines = array.new<line>()
var array<label> drawnLabels = array.new<label>()
var array<box> drawnBoxes = array.new<box>()
var table dashboard = table.new(position.top_right, 2, 11, bgcolor = panelColor, border_width = 1)

f_priceText(Level level) =>
    level.lo == level.hi ? str.tostring(level.lo, format.mintick) : str.tostring(level.lo, format.mintick) + "–" + str.tostring(level.hi, format.mintick)

// "J-1" lies once retention follows sessions: on a Monday the previous series is
// Friday's. The actual UTC date removes the ambiguity.
f_name(Level level) =>
    level.kind == 1 ? (level.epoch == utcDay ? "Fib J " : "Fib " + str.format_time(level.epoch, "dd/MM", "UTC") + " ") + level.caption : level.caption

f_color(Level level) =>
    color c = switch level.kind
        1 => level.epoch == utcDay ? fibTodayColor : fibPrevColor
        2 => math.abs(level.lo - mean) < 2.5 * deviation ? sd2Color : sd3Color
        3 => level.caption == "VAH ~" ? vahColor : level.caption == "VAL ~" ? valColor : pocColor
        => level.side == 1 ? rbUpperColor : rbLowerColor
    level.dead or not level.active ? inactiveColor : c

f_draw(Level level, int rightEdge, int labelOrder) =>
    color c = f_color(level)
    if level.kind == 4
        array.push(drawnBoxes, box.new(left = level.born, top = level.hi, right = rightEdge, bottom = level.lo, xloc = xloc.bar_time, border_color = c, bgcolor = color.new(c, rbOpacity)))
    else
        array.push(drawnLines, line.new(x1 = level.born, y1 = level.lo, x2 = rightEdge, y2 = level.hi, xloc = xloc.bar_time, color = c, style = f_style(), width = lineWidth))
    if showLabels
        string suffix = level.dead ? " [invalidé]" : not level.active ? " [dormant]" : ""
        int labelTime = rightEdge + int(chartSeconds * 1000) * labelSpacing * labelOrder
        array.push(drawnLabels, label.new(x = labelTime, y = (level.lo + level.hi) / 2, text = f_name(level) + " · " + f_priceText(level) + suffix, xloc = xloc.bar_time, style = label.style_label_left, color = color.new(c, 85), textcolor = c, size = f_font()))

f_collect(array<Level> source, array<Level> candidates, bool enabled, bool visible, int rightEdge, int offset) =>
    int n = offset
    for level in source
        bool eligible = level.active and not level.dead
        bool pocExcluded = level.kind == 3 and level.caption == "POC ~" and not includePoc
        if enabled and eligible and not pocExcluded
            array.push(candidates, level)
        bool previousHidden = level.kind == 1 and level.epoch != utcDay and not showPrevious
        bool statusVisible = eligible or (level.dead and showDead) or (not level.active and showDormant)
        if visible and statusVisible and not previousHidden
            f_draw(level, rightEdge, n)
            n += 1
    n

f_countKinds(array<Level> candidates, array<int> sortedIndices, int first, int last) =>
    bool a = false
    bool b = false
    bool c = false
    bool d = false
    for j = first to last
        int k = array.get(candidates, array.get(sortedIndices, j)).kind
        a := a or k == 1
        b := b or k == 2
        c := c or k == 3
        d := d or k == 4
    (a ? 1 : 0) + (b ? 1 : 0) + (c ? 1 : 0) + (d ? 1 : 0)

// Sweep possible minimum upper edges. For points: max(price)-min(price) <=
// tolerance, never transitive chaining. An RB spanning several separate groups
// can participate in each. Drop subsets, then retain zones nearest current price.
f_findPois(array<Level> candidates) =>
    array<Poi> zones = array.new<Poi>()
    array<float> highs = array.new_float()
    for level in candidates
        array.push(highs, level.hi)
    array<int> sortedIndices = array.sort_indices(highs, order.ascending)
    if array.size(sortedIndices) >= 2
        for seedIndex in sortedIndices
            float anchor = array.get(candidates, seedIndex).hi
            array<int> matched = array.new_int()
            float tightLo = na
            float tightHi = na
            for j = 0 to array.size(candidates) - 1
                Level member = array.get(candidates, j)
                if member.hi >= anchor and member.lo <= anchor + tolerance
                    array.push(matched, j)
                    tightLo := na(tightLo) ? member.lo : math.max(tightLo, member.lo)
                    tightHi := na(tightHi) ? member.hi : math.min(tightHi, member.hi)
            int kinds = f_countKinds(candidates, matched, 0, array.size(matched) - 1)
            int count = distinctKinds ? kinds : array.size(matched)
            bool subset = false
            if count >= minimumConcepts
                for previous in zones
                    bool contained = true
                    for id in matched
                        contained := contained and array.includes(previous.memberIds, id)
                    subset := subset or contained
            if count >= minimumConcepts and not subset
                string details = ""
                for id in matched
                    Level member = array.get(candidates, id)
                    details += (details == "" ? "" : "\n") + f_name(member) + " · " + f_priceText(member)
                array.push(zones, Poi.new(math.min(tightLo, tightHi), math.max(tightLo, tightHi), kinds, array.size(matched), details, matched))
    array<float> distances = array.new_float()
    for zone in zones
        array.push(distances, math.max(zone.lo - close, math.max(close - zone.hi, 0.0)))
    array<int> nearest = array.sort_indices(distances, order.ascending)
    array<Poi> selected = array.new<Poi>()
    for id in nearest
        if array.size(selected) < maxPoi
            array.push(selected, array.get(zones, id))
    selected

if barstate.islast
    for item in drawnLines
        line.delete(item)
    for item in drawnLabels
        label.delete(item)
    for item in drawnBoxes
        box.delete(item)
    array.clear(drawnLines)
    array.clear(drawnLabels)
    array.clear(drawnBoxes)
    int rightEdge = time_close + int(chartSeconds * 1000) * extendBars
    array<Level> candidates = array.new<Level>()
    int labelsUsed = f_collect(fibs, candidates, useFib, showFib, rightEdge, 0)
    labelsUsed := f_collect(vwapLevels, candidates, useVwap and vwapReady, showVwap and vwapReady, rightEdge, labelsUsed)
    labelsUsed := f_collect(vpLevels, candidates, useVp and vpReady, showVp and vpReady, rightEdge, labelsUsed)
    labelsUsed := f_collect(rbs, candidates, useRb, showRb, rightEdge, labelsUsed)
    if showGeometry and publishedDay == utcDay
        for multiplier in array.from(0.0, 1.0, 1.5)
            float p = today0 + multiplier * (today1 - today0)
            array.push(drawnLines, line.new(utcDay + rangeEnd * 60000, p, rightEdge, p, xloc = xloc.bar_time, color = color.new(fibTodayColor, 75), style = line.style_dotted))

    array<Poi> zones = f_findPois(candidates)
    int poiCount = array.size(zones)
    for zone in zones
        color c = zone.lo > close ? poiAboveColor : zone.hi < close ? poiBelowColor : poiAtPriceColor
        string positionText = zone.lo > close ? "AU-DESSUS" : zone.hi < close ? "EN DESSOUS" : "AU PRIX"
        array.push(drawnBoxes, box.new(left = time, top = zone.hi + poiPadding, right = rightEdge, bottom = zone.lo - poiPadding, xloc = xloc.bar_time, bgcolor = color.new(c, poiOpacity), border_color = c, border_width = 2))
        if showLabels
            string title = "POI " + str.tostring(zone.kinds) + " types / " + str.tostring(zone.members) + " niveaux · " + positionText
            array.push(drawnLabels, label.new(x = rightEdge, y = zone.hi + poiPadding, text = title, xloc = xloc.bar_time, style = label.style_label_lower_left, color = color.new(c, 15), textcolor = textColor, size = f_font(), tooltip = zone.details + "\nZone : " + str.tostring(zone.lo, format.mintick) + "–" + str.tostring(zone.hi, format.mintick)))

    if showDashboard
        string fibState = publishedDay == utcDay ? str.tostring(today0, format.mintick) + " → " + str.tostring(today1, format.mintick) : time < utcDay + rangeEnd * 60000 ? "Construction UTC…" : "Absente / incomplète / ambiguë"
        string vwapState = not vwapComplete ? "Historique / ancrage incomplet" : not accumulateVwap ? "Hors RTH" : weight <= 0 ? "Volume absent" : not vwapReady ? "Initialisation…" : "Formule hlc3 pondérée · ≠ DRW vérifié"
        string vpState = vpOverflow ? "CAPACITÉ DÉPASSÉE : élargir les lignes" : not vpComplete ? "Journée incomplète" : not vpReady ? "Initialisation / volume absent" : "ESTIMÉ · " + str.tostring(array.size(profile)) + " lignes"
        string retentionState = (calendarRetention ? "Jour calendaire" : "Séance") + " · " + str.tostring(array.size(fibEpochs)) + " série(s)" + (persistFib ? " · historique tracé" : "")
        array<string> keys = array.from("INDI NQ · v0.2", "Fib " + fibTf + "m", "Conservation", "VWAP", "Ancrage", "Profil UTC", "RB conservés", "Confluences", "Invalidation", "Données", "Validation")
        string dataState = (not na(volume) and volume > 0 ? "Volume disponible" : "Volume absent / nul") + (syminfo.root == "NQ" ? " · NQ" : " · vérifier NQ1!")
        array<string> values = array.from("Affichage uniquement", fibState, retentionState, vwapState, vwapAnchor, vpState, str.tostring(array.size(rbs)) + " · retirés par limite : " + str.tostring(evictedRb), str.tostring(poiCount) + " zones · " + str.tostring(array.size(candidates)) + " niveaux actifs", str.tostring(invalidation, "#.##") + " pts · extrêmes", dataState, "V1 : à comparer au graphique manuel")
        for row = 0 to 10
            table.cell(dashboard, 0, row, array.get(keys, row), text_color = textColor, text_size = f_font(), bgcolor = panelColor)
            table.cell(dashboard, 1, row, array.get(values, row), text_color = textColor, text_size = f_font(), bgcolor = panelColor)
    else
        table.clear(dashboard, 0, 0, 1, 10)
