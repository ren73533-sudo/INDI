//@version=6
indicator("INDI · NQ Key Levels & Reversal Zones [v0.3.1]", "INDI NQ", overlay = true, max_lines_count = 500, max_boxes_count = 200, max_labels_count = 400, max_bars_back = 500, dynamic_requests = true)

// Strategy requirements: docs/GPT-HANDOFF.md. Implementation decisions: docs/DECISIONS.md.
// Display only. No orders, alerts, directional filter or entry signals.
// A shared 1-minute engine builds all source candles. Display uses the previous completed minute.

const string G_CORE = "01 · Calibration / confluence"
const string G_FIB = "02 · Fib STDV · candle bodies only"
const string G_VWAP = "03 · VWAP / standard deviation"
const string G_VP = "04 · Estimated volume profile"
const string G_RB = "05 · Confirmed Rejection Blocks"
const string G_VIEW = "06 · Display"
const string G_COL = "07 · Colors"
const int DAY_MS = 86400000

float tolerance = input.float(15.0, "POI tolerance (points)", minval = 5, maxval = 50, step = 0.25, group = G_CORE)
bool distinctKinds = input.bool(true, "Require distinct concept types", tooltip = "ON: Fib + VWAP, for example. Two Fib levels or two RBs still count as one type. OFF: two levels are sufficient.", group = G_CORE)
int minimumConcepts = input.int(2, "Minimum concepts / levels", minval = 2, maxval = 4, group = G_CORE)
float invalidation = input.float(15.0, "Invalidation distance (points)", minval = 0.25, maxval = 100, step = 0.25, tooltip = "Resistance is invalidated when high >= its upper edge + distance; support when low <= its lower edge - distance. No candle close is required.", group = G_CORE)
bool invalidateMoving = input.bool(true, "Also invalidate VWAP / profile until the next reset", tooltip = "Checks the last level known before the candle. An invalidated moving level stays excluded from POIs until its session / daily reset. OFF: these levels remain continuously available moving references.", group = G_CORE)
int maxPoi = input.int(15, "Maximum displayed POI zones", minval = 1, maxval = 30, group = G_CORE)
float poiPadding = input.float(0.5, "POI visual padding (points)", minval = 0, maxval = 10, step = 0.25, tooltip = "Display only: does not change confluence or invalidation.", group = G_CORE)

bool useFib = input.bool(true, "Include Fib in confluence", group = G_FIB)
string fibTf = input.timeframe("5", "Construction timeframe", options = ["1", "5", "10", "15"], tooltip = "Default: 5 minutes, matching the prototype. These candles are built from 1-minute data independently of the chart timeframe. Changing this input changes the Fib anchors.", group = G_FIB)
string fibWindow = input.session("0000-0730", "Fixed UTC range window", tooltip = "The window must stay within one UTC day without crossing midnight. Both boundaries must align with the construction timeframe.", group = G_FIB)
string expansionMode = input.string("Both sides", "Arm ±3 / ±3.5 / ±4 expansion", options = ["Both sides", "By multiplier sign"], tooltip = "Both sides: a close outside [-2.5, +2.5] arms both bands. By multiplier sign: each sign arms independently. Uses completed 1-minute closes on every chart timeframe.", group = G_FIB)
bool showFib = input.bool(true, "Show individual Fib levels", group = G_FIB)
bool showGeometry = input.bool(false, "Show 0 / 1 / 1.5 (context only)", group = G_FIB)
bool showDormant = input.bool(false, "Show dormant expansion in gray", group = G_FIB)
bool showPrevious = input.bool(true, "Show the previous Fib set", tooltip = "Remains active in the engine when hidden. Only the two most recently published sets are retained.", group = G_FIB)
string fibRetention = input.string("Previous session", "Fib retention", options = ["Previous session", "Previous calendar day"], tooltip = "Previous session (v0.2 default): keeps the two most recently published sets, so Friday remains available on Monday. Previous calendar day: v0.1 behavior; sets older than the previous UTC date are removed even if no replacement has been published.", group = G_FIB)

bool useVwap = input.bool(true, "Include VWAP ±2 / ±3 in confluence", group = G_VWAP)
string vwapAnchor = input.string("Futures 22:00 UTC", "Anchor", options = ["Futures 22:00 UTC", "Futures CME 18:00 New York", "RTH New York", "Daily UTC", "Custom UTC time"], group = G_VWAP)
int vwapHour = input.int(22, "Custom UTC time", minval = 0, maxval = 23, group = G_VWAP, inline = "anchor")
int vwapMinute = input.int(0, "Minute", minval = 0, maxval = 59, group = G_VWAP, inline = "anchor")
bool rthOnly = input.bool(true, "RTH: accumulate only 09:30–16:00 New York", tooltip = "RTH follows US daylight saving time. Other anchor modes accumulate all available candles.", group = G_VWAP)
int vwapWarmup = input.int(5, "Band warmup (minutes)", minval = 1, maxval = 120, group = G_VWAP)
bool showVwap = input.bool(true, "Show VWAP references", group = G_VWAP)
bool showVwapCurve = input.bool(true, "Plot VWAP / band curves", group = G_VWAP)
bool showSd1 = input.bool(false, "Show ±1 SD (context only)", group = G_VWAP)

bool useVp = input.bool(true, "Include VAH / VAL in confluence", group = G_VP)
int vpTicks = input.int(20, "Profile row size (ticks)", minval = 1, maxval = 400, tooltip = "NQ: 20 ticks = 5 points. Candle volume is distributed uniformly across high–low: an estimate, not actual volume traded at each price.", group = G_VP)
float valueArea = input.float(70, "Value area (%)", minval = 50, maxval = 95, step = 1, group = G_VP)
int vpMaxRows = input.int(600, "Maximum profile rows (performance limit)", minval = 50, maxval = 2000, tooltip = "If the daily range exceeds capacity, the profile becomes unavailable. Increase the row size or limit; the profile is never silently truncated.", group = G_VP)
int vpWarmup = input.int(15, "Profile warmup (minutes after UTC midnight)", minval = 1, maxval = 240, group = G_VP)
bool includePoc = input.bool(false, "Include POC in confluence", tooltip = "OFF by default: POC is an absorption / context reference, not an entry level defined by the strategy.", group = G_VP)
bool showVp = input.bool(true, "Show VAH / VAL / POC", group = G_VP)

bool useRb = input.bool(true, "Include RBs in confluence", group = G_RB)
bool rb5 = input.bool(true, "5 min", group = G_RB, inline = "tf")
bool rb10 = input.bool(true, "10 min", group = G_RB, inline = "tf")
bool rb15 = input.bool(true, "15 min", group = G_RB, inline = "tf")
float wickBodyRatio = input.float(2.0, "Wick ≥ N × body", minval = 0.5, maxval = 10, step = 0.1, group = G_RB)
float wickPercent = input.float(60, "Wick ≥ % of candle range", minval = 10, maxval = 95, step = 1, group = G_RB)
int leadBars = input.int(2, "Prior move: lookback candles", minval = 1, maxval = 10, tooltip = "Net rise / fall in closes preceding the rejection candle. A configurable working definition to compare against your manually marked RBs.", group = G_RB)
string rbConfirm = input.string("Body", "Confirmation close beyond the", options = ["Body", "Extreme"], tooltip = "The very next candle must reverse color and close beyond the rejection body (default) or extreme. The RB becomes available only after confirmation.", group = G_RB)
int rbLimit = input.int(40, "Maximum retained RBs", minval = 5, maxval = 100, group = G_RB)
int rbMaxDays = input.int(0, "Expiration in days (0 = none)", minval = 0, maxval = 30, group = G_RB)
bool showRb = input.bool(true, "Show rejection wick zones", group = G_RB)

bool showLabels = input.bool(true, "Show labels with prices", group = G_VIEW)
bool showDashboard = input.bool(true, "Show status panel", group = G_VIEW)
bool persistFib = input.bool(false, "Show historical primary Fib traces", tooltip = "VALIDATION ONLY. Draws ±2 / ±2.25 / ±2.5 for each published day from publication to UTC day end. These static anchor traces do not track invalidation. Other level objects and POIs show the current state; use Bar Replay to inspect past confluence. Keep this OFF for the first test.", group = G_VIEW)
int persistDays = input.int(40, "Historical Fib days to retain", minval = 1, maxval = 75, tooltip = "Six lines per day. Older traces are removed beyond this count. Keep at 40 or below to reserve drawing capacity for live levels.", group = G_VIEW)
bool showDead = input.bool(false, "Show invalidated levels in gray", group = G_VIEW)
int extendBars = input.int(35, "Right projection (candles)", minval = 5, maxval = 250, group = G_VIEW)
int labelSpacing = input.int(0, "Label spacing (candles)", minval = 0, maxval = 3, group = G_VIEW)
int lineWidth = input.int(1, "Level line width", minval = 1, maxval = 4, group = G_VIEW)
string linePattern = input.string("Dotted", "Level line style", options = ["Solid", "Dashed", "Dotted"], group = G_VIEW)
string fontChoice = input.string("Small", "Text size", options = ["Small", "Normal", "Large"], group = G_VIEW)
int poiOpacity = input.int(82, "POI transparency (0 = opaque)", minval = 0, maxval = 100, group = G_VIEW)
int rbOpacity = input.int(91, "RB transparency", minval = 0, maxval = 100, group = G_VIEW)

color fibTodayColor = input.color(#f5c542, "Today Fib", group = G_COL)
color fibPrevColor = input.color(#b896e8, "Previous Fib set", group = G_COL)
color vwapColor = input.color(#d9e1ec, "VWAP center / ±1", group = G_COL)
color sd2Color = input.color(#33bbff, "VWAP ±2", group = G_COL)
color sd3Color = input.color(#3978ee, "VWAP ±3", group = G_COL)
color vahColor = input.color(#ff9c52, "VAH", group = G_COL)
color valColor = input.color(#50c997, "VAL", group = G_COL)
color pocColor = input.color(#df80bf, "POC", group = G_COL)
color rbUpperColor = input.color(#d87960, "Upper-wick RB", group = G_COL)
color rbLowerColor = input.color(#70b6a0, "Lower-wick RB", group = G_COL)
color poiAboveColor = input.color(#ef6c76, "POI above price", group = G_COL)
color poiBelowColor = input.color(#38c5a0, "POI below price", group = G_COL)
color poiAtPriceColor = input.color(#e3bd54, "POI at price", group = G_COL)
color inactiveColor = input.color(#747b88, "Dormant / invalidated", group = G_COL)
color textColor = input.color(#edf2f7, "Text", group = G_COL)
color panelColor = input.color(#18212d, "Panel background", group = G_COL)

// Append new controls after the original inputs to preserve their input IDs.
int engineBars = input.int(20000, "Engine history (1-minute candles)", minval = 3000, maxval = 100000, tooltip = "Shared source history on every chart timeframe. Increase if earlier sessions or older RBs are missing. Availability depends on your TradingView plan and feed.", group = G_CORE)

// kind: 1 Fib, 2 VWAP, 3 volume profile, 4 RB. side: +1 resistance, -1 support.
type Level
    float lo
    float hi
    int kind
    string caption
    int born
    int epoch
    int side
    bool active
    bool dead
    float multiplier
    float p0
    float leg

type Poi
    float lo
    float hi
    int kinds
    int members
    string details
    array<int> memberIds

type Candle
    int start
    int finish
    float o
    float h
    float l
    float c
    float v

type EngineState
    int asOf
    int day
    float referencePrice
    float sourceVolume
    float today0
    float today1
    int publishedDay
    int fibSets
    array<Level> fibs
    array<Level> vwapLevels
    array<Level> vpLevels
    array<Level> rbs
    array<float> profile
    float profileVolume
    int baseRow
    float mean
    float m2
    float weight
    int vwapEpoch
    bool vwapComplete
    bool accumulateVwap
    bool vwapReady
    bool vpComplete
    bool vpOverflow
    bool vpReady
    int evictedRb

f_day(int t) =>
    timestamp("UTC", year(t, "UTC"), month(t, "UTC"), dayofmonth(t, "UTC"), 0, 0)

f_side(float p, float reference) =>
    p >= reference ? 1 : -1

f_level(float lo, float hi, int kind, string caption, int born, int epoch, int side) =>
    Level.new(lo, hi, kind, caption, born, epoch, side, true, false, na, na, na)

f_breached(Level level) =>
    level.side == 1 ? high >= level.hi + invalidation : low <= level.lo - invalidation

f_font() =>
    fontChoice == "Large" ? size.large : fontChoice == "Normal" ? size.normal : size.small

f_style() =>
    linePattern == "Solid" ? line.style_solid : linePattern == "Dashed" ? line.style_dashed : line.style_dotted

int rangeStart = int(str.tonumber(str.substring(fibWindow, 0, 2))) * 60 + int(str.tonumber(str.substring(fibWindow, 2, 4)))
int rangeEnd = int(str.tonumber(str.substring(fibWindow, 5, 7))) * 60 + int(str.tonumber(str.substring(fibWindow, 7, 9)))
float chartSeconds = timeframe.in_seconds()
float fibSeconds = timeframe.in_seconds(fibTf)
if barstate.isfirst
    if not chart.is_standard or not timeframe.isintraday or not array.includes(array.from(60, 300, 600, 900, 1800, 3600, 14400), int(chartSeconds))
        runtime.error("V0.3: use standard 1m, 5m, 10m, 15m, 30m, 1h or 4h candles.")
    if rangeEnd <= rangeStart or (rangeStart * 60) % int(fibSeconds) != 0 or (rangeEnd * 60) % int(fibSeconds) != 0
        runtime.error("The Fib window must stay within one UTC day and its boundaries must align with the construction timeframe.")

f_anchor(string tz, int h, int m) =>
    int localMinute = hour(time, tz) * 60 + minute(time, tz)
    int dayOffset = localMinute < h * 60 + m ? -1 : 0
    timestamp(tz, year(time, tz), month(time, tz), dayofmonth(time, tz) + dayOffset, h, m)

// Fib needs the complete construction window. RBs keep the original source-bar
// definition: aggregate the available trades, including sparse source candles.
// If the final minute is absent, publish that closed RB candle at the next bar.
f_aggregate(int minutes, bool requireFull) =>
    int duration = minutes * 60000
    int bucket = int(math.floor(time / duration)) * duration
    var Candle current = na
    var int count = 0
    var bool startsAtBoundary = false
    var bool emitted = false
    Candle completed = na
    if na(current) or current.start != bucket
        if not na(current) and not emitted and not requireFull
            completed := current.copy()
        current := Candle.new(bucket, bucket + duration, open, high, low, close, nz(volume))
        count := 1
        startsAtBoundary := time == bucket
        emitted := false
    else
        current.h := math.max(current.h, high)
        current.l := math.min(current.l, low)
        current.c := close
        current.v += nz(volume)
        count += 1
    if na(completed) and time_close == current.finish and (not requireFull or (startsAtBoundary and count == minutes))
        completed := current.copy()
        emitted := true
    completed

f_range(Candle completed) =>
    var int day = na
    var float hi = na
    var float lo = na
    var int hiTime = na
    var int loTime = na
    var bool completeStart = false
    var int completedCandles = 0
    var bool ready = false
    var float p0 = na
    var float p1 = na
    int d = f_day(time)
    if na(day) or d != day
        day := d
        hi := na
        lo := na
        hiTime := na
        loTime := na
        completeStart := false
        completedCandles := 0
        ready := false
        p0 := na
        p1 := na
    if not na(completed)
        int m = hour(completed.start, "UTC") * 60 + minute(completed.start, "UTC")
        if m >= rangeStart and m < rangeEnd
            completedCandles += 1
            float bh = math.max(completed.o, completed.c)
            float bl = math.min(completed.o, completed.c)
            if na(hi) or bh > hi
                hi := bh
                hiTime := completed.start
            if na(lo) or bl < lo
                lo := bl
                loTime := completed.start
            completeStart := completeStart or m == rangeStart
            if completed.finish == d + rangeEnd * 60000 and completeStart and completedCandles == (rangeEnd - rangeStart) * 60 / fibSeconds and hi > lo and hiTime != loTime
                p0 := hiTime < loTime ? hi : lo
                p1 := hiTime < loTime ? lo : hi
                ready := true
    [p0, p1, day, ready]

f_copyLevels(array<Level> levels) =>
    array<Level> copied = array.new<Level>()
    for level in levels
        array.push(copied, level.copy())
    copied

// Rejection candle is history[1], confirmation history[0]. This is the same
// body / wick / prior-move definition as v0.2, on completed aggregated candles.
f_updateRbs(Candle completed, array<Candle> history, array<Level> levels, string caption, bool enabled) =>
    if not na(completed)
        array.unshift(history, completed)
        if enabled and array.size(history) >= leadBars + 3
            Candle confirmation = array.get(history, 0)
            Candle rejection = array.get(history, 1)
            Candle before = array.get(history, 2)
            Candle earlier = array.get(history, 2 + leadBars)
            float bodyHi = math.max(rejection.o, rejection.c)
            float bodyLo = math.min(rejection.o, rejection.c)
            float body = math.max(bodyHi - bodyLo, syminfo.mintick)
            float span = rejection.h - rejection.l
            float upper = rejection.h - bodyHi
            float lower = bodyLo - rejection.l
            bool upMove = before.c > earlier.c
            bool downMove = before.c < earlier.c
            bool rejectHigh = span > 0 and upper >= wickBodyRatio * body and upper >= span * wickPercent / 100.0
            bool rejectLow = span > 0 and lower >= wickBodyRatio * body and lower >= span * wickPercent / 100.0
            bool reverseDown = confirmation.c < confirmation.o and confirmation.c < (rbConfirm == "Body" ? bodyLo : rejection.l)
            bool reverseUp = confirmation.c > confirmation.o and confirmation.c > (rbConfirm == "Body" ? bodyHi : rejection.h)
            bool upperRb = upMove and rejectHigh and reverseDown and confirmation.h < rejection.h + invalidation
            bool lowerRb = downMove and rejectLow and reverseUp and confirmation.l > rejection.l - invalidation
            if upperRb or lowerRb
                array.push(levels, f_level(upperRb ? bodyHi : rejection.l, upperRb ? rejection.h : bodyLo, 4, caption, confirmation.finish, rejection.start, upperRb ? 1 : -1))
        while array.size(history) > leadBars + 3
            array.pop(history)
    array.size(history)

// The snapshot is copied BEFORE this minute is updated. It therefore contains
// completed-minute data on every chart, without relying on barstate.isconfirmed
// inside request.security(). Collections are exported only on the last source
// bar, keeping historical request memory bounded. Scalars retain VWAP history.
f_engine() =>
    var array<Level> fibs = array.new<Level>()
    var array<int> fibEpochs = array.new_int()
    var int publishedDay = na
    var float today0 = na
    var float today1 = na
    var array<Level> vwapLevels = array.new<Level>()
    var int vwapEpoch = na
    var float weight = 0.0
    var float mean = na
    var float m2 = 0.0
    var bool vwapComplete = false
    var bool accumulateVwap = false
    var bool vwapReady = false
    var array<float> profile = array.new_float()
    var int baseRow = na
    var bool vpOverflow = false
    var bool vpComplete = false
    var float profileVolume = 0.0
    var array<Level> vpLevels = array.new<Level>()
    var bool vpReady = false
    var array<Level> rbs = array.new<Level>()
    var array<Candle> history5 = array.new<Candle>()
    var array<Candle> history10 = array.new<Candle>()
    var array<Candle> history15 = array.new<Candle>()
    var int evictedRb = 0
    var int asOf = na
    var int stateDay = na
    var float referencePrice = na
    var float sourceVolume = 0.0
    float closedMean = mean
    float closedSd = weight > 0 ? math.sqrt(math.max(m2 / weight, 0.0)) : na
    bool closedComplete = vwapComplete
    bool closedAccumulating = accumulateVwap
    int closedEpoch = vwapEpoch
    float closed0 = today0
    float closed1 = today1
    int closedPublished = publishedDay
    int closedDay = stateDay
    bool exportSnapshot = barstate.islast
    EngineState snapshot = na
    if exportSnapshot and not na(asOf)
        snapshot := EngineState.new(asOf, stateDay, referencePrice, sourceVolume, today0, today1, publishedDay, array.size(fibEpochs), f_copyLevels(fibs), f_copyLevels(vwapLevels), f_copyLevels(vpLevels), f_copyLevels(rbs), array.copy(profile), profileVolume, baseRow, mean, m2, weight, vwapEpoch, vwapComplete, accumulateVwap, vwapReady, vpComplete, vpOverflow, vpReady, evictedRb)
    int utcDay = f_day(time)
    bool newDay = na(stateDay) or utcDay != stateDay
    bool calendarRetention = fibRetention == "Previous calendar day"
    [range0, range1, rangeDay, rangeReady] = f_range(f_aggregate(int(fibSeconds / 60), true))
    if newDay
        today0 := na
        today1 := na
        if calendarRetention
            int i = array.size(fibs) - 1
            while i >= 0
                if array.get(fibs, i).epoch < utcDay - DAY_MS
                    array.remove(fibs, i)
                i -= 1
            while array.size(fibEpochs) > 0 and array.get(fibEpochs, 0) < utcDay - DAY_MS
                array.shift(fibEpochs)

    if rangeReady and rangeDay == utcDay and (na(publishedDay) or publishedDay != rangeDay)
        today0 := range0
        today1 := range1
        publishedDay := rangeDay
        array<float> multipliers = array.from(2.0, 2.25, 2.5, -2.0, -2.25, -2.5, 3.0, 3.5, 4.0, -3.0, -3.5, -4.0)
        for multiplier in multipliers
            float price = range0 + multiplier * (range1 - range0)
            string signedName = (multiplier > 0 ? "+" : "") + str.tostring(multiplier, "#.##")
            Level level = f_level(price, price, 1, signedName, utcDay + rangeEnd * 60000, utcDay, f_side(price, close))
            level.multiplier := multiplier
            level.p0 := range0
            level.leg := range1 - range0
            level.active := math.abs(multiplier) <= 2.5
            array.push(fibs, level)
        if not array.includes(fibEpochs, utcDay)
            array.push(fibEpochs, utcDay)
        if not calendarRetention
            while array.size(fibEpochs) > 2
                int stale = array.shift(fibEpochs)
                int k = array.size(fibs) - 1
                while k >= 0
                    if array.get(fibs, k).epoch == stale
                        array.remove(fibs, k)
                    k -= 1

    for level in fibs
        bool justArmed = false
        if not level.active and not level.dead
            float coordinate = (close - level.p0) / level.leg
            bool crossed = expansionMode == "Both sides" ? (coordinate > 2.5 or coordinate < -2.5) : (level.multiplier > 0 ? coordinate > 2.5 : coordinate < -2.5)
            if crossed
                level.active := true
                level.side := f_side(level.lo, close)
                justArmed := true
        if level.active and not level.dead and not justArmed and level.born <= time and f_breached(level)
            level.dead := true

    int anchorKey = switch vwapAnchor
        "Futures CME 18:00 New York" => f_anchor("America/New_York", 18, 0)
        "RTH New York" => f_anchor("America/New_York", 9, 30)
        "Daily UTC" => utcDay
        "Custom UTC time" => f_anchor("UTC", vwapHour, vwapMinute)
        => f_anchor("UTC", 22, 0)
    bool inRth = not na(time(timeframe.period, "0930-1600:23456", "America/New_York"))
    accumulateVwap := vwapAnchor != "RTH New York" or not rthOnly or inRth
    if accumulateVwap
        if na(vwapEpoch) or anchorKey != vwapEpoch
            vwapEpoch := anchorKey
            weight := 0.0
            mean := na
            m2 := 0.0
            // An anchor can fall in a legitimate exchange closure (e.g. fixed 22:00
            // UTC during winter CME maintenance). A loaded bar before the boundary
            // proves we did not simply start the dataset midway through the session.
            vwapComplete := time == anchorKey or (not na(time_close[1]) and time_close[1] <= anchorKey)
            array.clear(vwapLevels)
        if not na(volume) and volume > 0
            float newWeight = weight + volume
            float delta = na(mean) ? 0.0 : hlc3 - mean
            float newMean = na(mean) ? hlc3 : mean + volume / newWeight * delta
            m2 += volume * delta * (hlc3 - newMean)
            mean := newMean
            weight := newWeight
    float deviation = weight > 0 ? math.sqrt(math.max(m2 / weight, 0.0)) : na
    vwapReady := accumulateVwap and vwapComplete and weight > 0 and deviation >= syminfo.mintick and time_close >= vwapEpoch + vwapWarmup * 60000
    array<float> vwapPrices = array.from(mean + 2 * deviation, mean - 2 * deviation, mean + 3 * deviation, mean - 3 * deviation)
    if vwapReady and array.size(vwapLevels) == 0
        array<string> names = array.from("VWAP +2 SD", "VWAP -2 SD", "VWAP +3 SD", "VWAP -3 SD")
        for i = 0 to 3
            float price = array.get(vwapPrices, i)
            array.push(vwapLevels, f_level(price, price, 2, array.get(names, i), time_close, vwapEpoch, f_side(price, close)))
    else if vwapReady
        for i = 0 to array.size(vwapLevels) - 1
            Level level = array.get(vwapLevels, i)
            if invalidateMoving and f_breached(level)
                level.dead := true
            level.lo := array.get(vwapPrices, i)
            level.hi := level.lo
            if not invalidateMoving
                level.side := f_side(level.lo, close)

    float rowSize = vpTicks * syminfo.mintick
    // Keep the daily state independent of the dataset's final date. Only the
    // current day's buckets are retained; this also preserves a cold-reload
    // snapshot at midnight or a market reopening.
    bool profileDay = true
    if newDay
        array.clear(profile)
        array.clear(vpLevels)
        baseRow := na
        vpOverflow := false
        vpComplete := time == utcDay or (not na(time_close[1]) and time_close[1] <= utcDay)
        profileVolume := 0.0
    if profileDay and not vpOverflow and not na(volume) and volume > 0
        int bottomRow = int(math.floor(low / rowSize))
        int topRow = int(math.floor(high / rowSize))
        int nextBase = na(baseRow) ? bottomRow : math.min(baseRow, bottomRow)
        int nextTop = na(baseRow) ? topRow : math.max(baseRow + array.size(profile) - 1, topRow)
        if nextTop - nextBase + 1 > vpMaxRows
            vpOverflow := true
            array.clear(vpLevels)
        else
            if na(baseRow)
                baseRow := bottomRow
            while baseRow > nextBase
                array.unshift(profile, 0.0)
                baseRow -= 1
            while array.size(profile) < nextTop - baseRow + 1
                array.push(profile, 0.0)
            for row = bottomRow to topRow
                float overlap = math.max(0.0, math.min(high, (row + 1) * rowSize) - math.max(low, row * rowSize))
                float allocated = high == low ? volume : volume * overlap / (high - low)
                int index = row - baseRow
                array.set(profile, index, array.get(profile, index) + allocated)
            profileVolume += volume

    vpReady := profileDay and vpComplete and not vpOverflow and profileVolume > 0 and time_close >= utcDay + vpWarmup * 60000
    float poc = na
    float vah = na
    float val = na
    if vpReady
        float peak = -1.0
        int pocIndex = 0
        for i = 0 to array.size(profile) - 1
            float v = array.get(profile, i)
            if v > peak
                peak := v
                pocIndex := i
        int left = pocIndex
        int right = pocIndex
        float captured = peak
        float target = profileVolume * valueArea / 100.0
        while captured < target and (left > 0 or right < array.size(profile) - 1)
            float lv = left > 0 ? array.get(profile, left - 1) : -1.0
            float rv = right < array.size(profile) - 1 ? array.get(profile, right + 1) : -1.0
            if lv >= rv and left > 0
                left -= 1
                captured += lv
            if rv >= lv and right < array.size(profile) - 1
                right += 1
                captured += rv
        poc := (baseRow + pocIndex + 0.5) * rowSize
        vah := (baseRow + right + 1) * rowSize
        val := (baseRow + left) * rowSize
        array<float> prices = array.from(vah, val, poc)
        if array.size(vpLevels) == 0
            array<string> names = array.from("VAH ~", "VAL ~", "POC ~")
            for i = 0 to 2
                float price = array.get(prices, i)
                array.push(vpLevels, f_level(price, price, 3, array.get(names, i), time_close, utcDay, f_side(price, close)))
        else
            for i = 0 to 2
                Level level = array.get(vpLevels, i)
                if invalidateMoving and f_breached(level)
                    level.dead := true
                level.lo := array.get(prices, i)
                level.hi := level.lo
                if not invalidateMoving
                    level.side := f_side(level.lo, close)

    f_updateRbs(f_aggregate(5, false), history5, rbs, "RB 5m", rb5)
    f_updateRbs(f_aggregate(10, false), history10, rbs, "RB 10m", rb10)
    f_updateRbs(f_aggregate(15, false), history15, rbs, "RB 15m", rb15)
    for level in rbs
        if not level.dead and level.born <= time and f_breached(level)
            level.dead := true
    int rbIndex = array.size(rbs) - 1
    while rbIndex >= 0
        Level level = array.get(rbs, rbIndex)
        bool expired = rbMaxDays > 0 and time_close - level.epoch >= rbMaxDays * DAY_MS
        if expired or (level.dead and not showDead)
            array.remove(rbs, rbIndex)
        rbIndex -= 1
    while array.size(rbs) > rbLimit
        array.shift(rbs)
        evictedRb += 1
    asOf := time_close
    stateDay := utcDay
    referencePrice := close
    sourceVolume := nz(volume)
    [snapshot, closedMean, closedSd, closedComplete, closedAccumulating, closedEpoch, closed0, closed1, closedPublished, closedDay]

[snapshot, curveMean, curveSd, curveComplete, curveAccumulating, curveEpoch, trace0, trace1, tracePublished, traceDay] = request.security(syminfo.tickerid, "1", f_engine(), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off, calc_bars_count = engineBars)
bool engineAvailable = not na(snapshot)
array<Level> fibs = engineAvailable ? snapshot.fibs : array.new<Level>()
array<Level> vwapLevels = engineAvailable ? snapshot.vwapLevels : array.new<Level>()
array<Level> vpLevels = engineAvailable ? snapshot.vpLevels : array.new<Level>()
array<Level> rbs = engineAvailable ? snapshot.rbs : array.new<Level>()
array<float> profile = engineAvailable ? snapshot.profile : array.new_float()
int utcDay = engineAvailable ? snapshot.day : traceDay
float referencePrice = engineAvailable ? snapshot.referencePrice : close
float today0 = engineAvailable ? snapshot.today0 : na
float today1 = engineAvailable ? snapshot.today1 : na
int publishedDay = engineAvailable ? snapshot.publishedDay : na
float mean = engineAvailable ? snapshot.mean : curveMean
float m2 = engineAvailable ? snapshot.m2 : na
float weight = engineAvailable ? snapshot.weight : 0.0
float deviation = engineAvailable and weight > 0 ? math.sqrt(math.max(m2 / weight, 0.0)) : curveSd
int vwapEpoch = engineAvailable ? snapshot.vwapEpoch : na
bool vwapComplete = engineAvailable and snapshot.vwapComplete
bool accumulateVwap = engineAvailable and snapshot.accumulateVwap
bool vwapReady = engineAvailable and snapshot.vwapReady
bool vpComplete = engineAvailable and snapshot.vpComplete
bool vpOverflow = engineAvailable and snapshot.vpOverflow
bool vpReady = engineAvailable and snapshot.vpReady
float profileVolume = engineAvailable ? snapshot.profileVolume : 0.0
int evictedRb = engineAvailable ? snapshot.evictedRb : 0
bool calendarRetention = fibRetention == "Previous calendar day"

// Historical anchor traces are created on the display chart, never inside a
// security request. Reserve at least 50 line slots for live levels / geometry.
var array<line> staticLines = array.new<line>()
var int lastTraceDay = na
if persistFib and not na(tracePublished) and tracePublished == traceDay and (na(lastTraceDay) or tracePublished != lastTraceDay)
    while array.size(staticLines) + 6 > persistDays * 6
        line.delete(array.shift(staticLines))
    for multiplier in array.from(2.0, 2.25, 2.5, -2.0, -2.25, -2.5)
        float price = trace0 + multiplier * (trace1 - trace0)
        array.push(staticLines, line.new(tracePublished + rangeEnd * 60000, price, tracePublished + DAY_MS, price, xloc = xloc.bar_time, color = color.new(fibTodayColor, 35), style = f_style(), width = lineWidth))
    lastTraceDay := tracePublished

// Curves are CONTEXT: invalidated bands may remain visible but cannot enter POIs.
bool curveVisible = showVwap and showVwapCurve and curveComplete and curveAccumulating
bool anchorChanged = curveEpoch != curveEpoch[1]
plot(curveVisible and not anchorChanged ? curveMean : na, "VWAP hlc3", color = vwapColor, linewidth = 2, style = plot.style_linebr)
plot(curveVisible and not anchorChanged ? curveMean + 2 * curveSd : na, "VWAP +2 SD context", color = sd2Color, style = plot.style_linebr)
plot(curveVisible and not anchorChanged ? curveMean - 2 * curveSd : na, "VWAP -2 SD context", color = sd2Color, style = plot.style_linebr)
plot(curveVisible and not anchorChanged ? curveMean + 3 * curveSd : na, "VWAP +3 SD context", color = sd3Color, style = plot.style_linebr)
plot(curveVisible and not anchorChanged ? curveMean - 3 * curveSd : na, "VWAP -3 SD context", color = sd3Color, style = plot.style_linebr)
plot(curveVisible and showSd1 and not anchorChanged ? curveMean + curveSd : na, "VWAP +1 SD context only", color = color.new(vwapColor, 65), style = plot.style_linebr)
plot(curveVisible and showSd1 and not anchorChanged ? curveMean - curveSd : na, "VWAP -1 SD context only", color = color.new(vwapColor, 65), style = plot.style_linebr)

// Render the current state only. No historic POI boxes suggesting retrospective signals.
var array<line> drawnLines = array.new<line>()
var array<label> drawnLabels = array.new<label>()
var array<box> drawnBoxes = array.new<box>()
var table dashboard = table.new(position.top_right, 2, 12, bgcolor = panelColor, border_width = 1)

f_priceText(Level level) =>
    level.lo == level.hi ? str.tostring(level.lo, format.mintick) : str.tostring(level.lo, format.mintick) + "–" + str.tostring(level.hi, format.mintick)

// "Yesterday" is misleading with session retention: on Monday the previous set is
// Friday's. The actual UTC date removes the ambiguity.
f_name(Level level) =>
    level.kind == 1 ? (level.epoch == utcDay ? "Fib Today " : "Fib " + str.format_time(level.epoch, "dd/MM", "UTC") + " ") + level.caption : level.caption

f_color(Level level) =>
    color c = switch level.kind
        1 => level.epoch == utcDay ? fibTodayColor : fibPrevColor
        2 => math.abs(level.lo - mean) < 2.5 * deviation ? sd2Color : sd3Color
        3 => level.caption == "VAH ~" ? vahColor : level.caption == "VAL ~" ? valColor : pocColor
        => level.side == 1 ? rbUpperColor : rbLowerColor
    level.dead or not level.active ? inactiveColor : c

f_draw(Level level, int rightEdge, int labelOrder) =>
    color c = f_color(level)
    if level.kind == 4
        array.push(drawnBoxes, box.new(left = level.born, top = level.hi, right = rightEdge, bottom = level.lo, xloc = xloc.bar_time, border_color = c, bgcolor = color.new(c, rbOpacity)))
    else
        array.push(drawnLines, line.new(x1 = level.born, y1 = level.lo, x2 = rightEdge, y2 = level.hi, xloc = xloc.bar_time, color = c, style = f_style(), width = lineWidth))
    if showLabels
        string suffix = level.dead ? " [invalidated]" : not level.active ? " [dormant]" : ""
        int labelTime = rightEdge + int(chartSeconds * 1000) * labelSpacing * labelOrder
        array.push(drawnLabels, label.new(x = labelTime, y = (level.lo + level.hi) / 2, text = f_name(level) + " · " + f_priceText(level) + suffix, xloc = xloc.bar_time, style = label.style_label_left, color = color.new(c, 85), textcolor = c, size = f_font()))

f_collect(array<Level> source, array<Level> candidates, bool enabled, bool visible, int rightEdge, int offset) =>
    int n = offset
    for level in source
        bool eligible = level.active and not level.dead
        bool pocExcluded = level.kind == 3 and level.caption == "POC ~" and not includePoc
        if enabled and eligible and not pocExcluded
            array.push(candidates, level)
        bool previousHidden = level.kind == 1 and level.epoch != utcDay and not showPrevious
        bool statusVisible = eligible or (level.dead and showDead) or (not level.active and showDormant)
        if visible and statusVisible and not previousHidden
            f_draw(level, rightEdge, n)
            n += 1
    n

f_countKinds(array<Level> candidates, array<int> sortedIndices, int first, int last) =>
    bool a = false
    bool b = false
    bool c = false
    bool d = false
    for j = first to last
        int k = array.get(candidates, array.get(sortedIndices, j)).kind
        a := a or k == 1
        b := b or k == 2
        c := c or k == 3
        d := d or k == 4
    (a ? 1 : 0) + (b ? 1 : 0) + (c ? 1 : 0) + (d ? 1 : 0)

// Sweep possible minimum upper edges. For points: max(price)-min(price) <=
// tolerance, never transitive chaining. An RB spanning several separate groups
// can participate in each. Drop subsets, then retain zones nearest current price.
f_findPois(array<Level> candidates, float reference) =>
    array<Poi> zones = array.new<Poi>()
    array<float> highs = array.new_float()
    for level in candidates
        array.push(highs, level.hi)
    array<int> sortedIndices = array.sort_indices(highs, order.ascending)
    if array.size(sortedIndices) >= 2
        for seedIndex in sortedIndices
            float anchor = array.get(candidates, seedIndex).hi
            array<int> matched = array.new_int()
            float tightLo = na
            float tightHi = na
            for j = 0 to array.size(candidates) - 1
                Level member = array.get(candidates, j)
                if member.hi >= anchor and member.lo <= anchor + tolerance
                    array.push(matched, j)
                    tightLo := na(tightLo) ? member.lo : math.max(tightLo, member.lo)
                    tightHi := na(tightHi) ? member.hi : math.min(tightHi, member.hi)
            int kinds = f_countKinds(candidates, matched, 0, array.size(matched) - 1)
            int count = distinctKinds ? kinds : array.size(matched)
            bool subset = false
            if count >= minimumConcepts
                for previous in zones
                    bool contained = true
                    for id in matched
                        contained := contained and array.includes(previous.memberIds, id)
                    subset := subset or contained
            if count >= minimumConcepts and not subset
                string details = ""
                for id in matched
                    Level member = array.get(candidates, id)
                    details += (details == "" ? "" : "\n") + f_name(member) + " · " + f_priceText(member)
                array.push(zones, Poi.new(math.min(tightLo, tightHi), math.max(tightLo, tightHi), kinds, array.size(matched), details, matched))
    array<float> distances = array.new_float()
    for zone in zones
        array.push(distances, math.max(zone.lo - reference, math.max(reference - zone.hi, 0.0)))
    array<int> nearest = array.sort_indices(distances, order.ascending)
    array<Poi> selected = array.new<Poi>()
    for id in nearest
        if array.size(selected) < maxPoi
            array.push(selected, array.get(zones, id))
    selected

if barstate.islast
    for item in drawnLines
        line.delete(item)
    for item in drawnLabels
        label.delete(item)
    for item in drawnBoxes
        box.delete(item)
    array.clear(drawnLines)
    array.clear(drawnLabels)
    array.clear(drawnBoxes)
    int rightEdge = (engineAvailable ? snapshot.asOf : time_close) + int(chartSeconds * 1000) * extendBars
    array<Level> candidates = array.new<Level>()
    int labelsUsed = f_collect(fibs, candidates, useFib, showFib, rightEdge, 0)
    labelsUsed := f_collect(vwapLevels, candidates, useVwap and vwapReady, showVwap and vwapReady, rightEdge, labelsUsed)
    labelsUsed := f_collect(vpLevels, candidates, useVp and vpReady, showVp and vpReady, rightEdge, labelsUsed)
    labelsUsed := f_collect(rbs, candidates, useRb, showRb, rightEdge, labelsUsed)
    if showGeometry and publishedDay == utcDay
        for multiplier in array.from(0.0, 1.0, 1.5)
            float p = today0 + multiplier * (today1 - today0)
            array.push(drawnLines, line.new(utcDay + rangeEnd * 60000, p, rightEdge, p, xloc = xloc.bar_time, color = color.new(fibTodayColor, 75), style = line.style_dotted))

    array<Poi> zones = f_findPois(candidates, referencePrice)
    int poiCount = array.size(zones)
    for zone in zones
        color c = zone.lo > referencePrice ? poiAboveColor : zone.hi < referencePrice ? poiBelowColor : poiAtPriceColor
        string positionText = zone.lo > referencePrice ? "ABOVE PRICE" : zone.hi < referencePrice ? "BELOW PRICE" : "AT PRICE"
        array.push(drawnBoxes, box.new(left = snapshot.asOf, top = zone.hi + poiPadding, right = rightEdge, bottom = zone.lo - poiPadding, xloc = xloc.bar_time, bgcolor = color.new(c, poiOpacity), border_color = c, border_width = 2))
        if showLabels
            string title = "POI " + str.tostring(zone.kinds) + " types / " + str.tostring(zone.members) + " levels · " + positionText
            array.push(drawnLabels, label.new(x = rightEdge, y = zone.hi + poiPadding, text = title, xloc = xloc.bar_time, style = label.style_label_lower_left, color = color.new(c, 15), textcolor = textColor, size = f_font(), tooltip = zone.details + "\nZone: " + str.tostring(zone.lo, format.mintick) + "–" + str.tostring(zone.hi, format.mintick)))

    if showDashboard
        string fibState = publishedDay == utcDay ? str.tostring(today0, format.mintick) + " → " + str.tostring(today1, format.mintick) : (engineAvailable ? snapshot.asOf : time_close) < utcDay + rangeEnd * 60000 ? "Building UTC range…" : "Missing / incomplete / ambiguous"
        string vwapState = not vwapComplete ? "Incomplete history / anchor" : not accumulateVwap ? "Outside RTH" : weight <= 0 ? "No volume" : not vwapReady ? "Warming up…" : "Weighted hlc3 formula · DRW match unverified"
        string vpState = vpOverflow ? "CAPACITY EXCEEDED: increase row size" : not vpComplete ? "Incomplete UTC day" : not vpReady ? "Warming up / no volume" : "ESTIMATED · " + str.tostring(array.size(profile)) + " rows"
        string retentionState = (calendarRetention ? "Calendar day" : "Session") + " · " + str.tostring((engineAvailable ? snapshot.fibSets : 0)) + " set(s)" + (persistFib ? " · history traces on" : "")
        array<string> keys = array.from("INDI NQ · v0.3.1", "1m engine as of", "Fib " + fibTf + "m", "Retention", "VWAP", "Anchor", "UTC profile", "Retained RBs", "Confluence", "Invalidation", "Data", "Validation")
        string dataState = (engineAvailable and snapshot.sourceVolume > 0 ? "Volume available" : "Missing / zero volume") + (syminfo.root == "NQ" ? " · NQ" : " · check NQ1!")
        array<string> values = array.from("Display only", engineAvailable ? str.format_time(snapshot.asOf, "yyyy-MM-dd HH:mm", "UTC") + " UTC" : "1m DATA UNAVAILABLE: check history / feed", fibState, retentionState, vwapState, vwapAnchor, vpState, str.tostring(array.size(rbs)) + " · removed by capacity: " + str.tostring(evictedRb), str.tostring(poiCount) + " zones · " + str.tostring(array.size(candidates)) + " active levels", str.tostring(invalidation, "#.##") + " pts · high / low", dataState, "Completed 1m data · up to one minute delay")
        for row = 0 to 11
            table.cell(dashboard, 0, row, array.get(keys, row), text_color = textColor, text_size = f_font(), bgcolor = panelColor)
            table.cell(dashboard, 1, row, array.get(values, row), text_color = textColor, text_size = f_font(), bgcolor = panelColor)
    else
        table.clear(dashboard, 0, 0, 1, 11)
