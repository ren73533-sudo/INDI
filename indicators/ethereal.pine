//@version=6
indicator("幽玄", "幽玄", overlay = true, max_boxes_count = 300, max_bars_back = 500, dynamic_requests = true)

// Ethereal / Yugen v1.3.0. Standalone build: node tools/build-ethereal.mjs.
// Same strategy calculations as nq_key_levels.pine; confluence boxes with optional text.
// Fixed timestamp / price anchors. Completed 1-minute data; up to one minute delay.

const string G_CORE = "01 · Confluence"
const string G_BOX = "02 · Boxes"
const string G_GOLD = "03 · Yellow qualification"
const string G_FIB = "04 · Fib STDV"
const string G_VWAP = "05 · VWAP"
const string G_VP = "06 · Estimated volume profile"
const string G_RB = "07 · Rejection Blocks"
const int DAY_MS = 86400000
const bool distinctKinds = true
const int minimumConcepts = 2
const bool showDead = false

float tolerance = input.float(15.0, "Confluence tolerance (points)", minval = 0.25, maxval = 100, step = 0.25, tooltip = "At least two distinct types: Fib, VWAP, VAH/VAL or RB. Two Fib levels or two RB timeframes count as one type. Alignment order does not matter.", group = G_CORE)
float invalidation = input.float(15.0, "Invalidation distance (points)", minval = 0.25, maxval = 100, step = 0.25, group = G_CORE)
bool invalidateMoving = input.bool(true, "Also invalidate VWAP / profile until the next reset", group = G_CORE)
int engineBars = input.int(6000, "Engine history (1-minute candles)", minval = 3000, maxval = 100000, tooltip = "Must cover the overnight range, VWAP anchor and prior session. Actual availability depends on your TradingView plan and feed.", group = G_CORE)
int maxPoi = input.int(8, "Maximum displayed active zones", minval = 1, maxval = 30, tooltip = "Show the nearest resting areas. Other retained zones keep their original anchors and can become visible as price approaches.", group = G_CORE)

float minimumHeight = input.float(5.0, "Zone height (points)", minval = 0.25, maxval = 200, step = 0.25, tooltip = "Fixed height: exact height before padding. Cover confluence span: minimum height. Prices are frozen at creation.", group = G_BOX)
float boxPadding = input.float(0.5, "Box padding per side (points)", minval = 0, maxval = 50, step = 0.25, group = G_BOX)
int boxMinutes = input.int(240, "Right projection (minutes)", minval = 15, maxval = 1440, tooltip = "Active zones stretch across the chart toward future time. Only the right edge advances with market time; zoom never changes the zone's start or price bounds.", group = G_BOX)
int zoneDays = input.int(2, "Invalidated zone history (calendar days)", minval = 1, maxval = 30, group = G_BOX)
int zoneLimit = input.int(150, "Maximum retained zones", minval = 15, maxval = 150, group = G_BOX)
color greenColor = input.color(#27ae60, "Standard alignment color (green)", group = G_BOX)
color yellowColor = input.color(#f1c40f, "Full qualification color (yellow)", group = G_BOX)
int boxOpacity = input.int(78, "Fill transparency (0 = opaque)", minval = 0, maxval = 100, group = G_BOX)
int borderWidth = input.int(1, "Border width", minval = 0, maxval = 4, group = G_BOX)

string yellowRbTf = input.timeframe("5", "Yellow RB reference timeframe", options = ["1", "5", "10", "15"], tooltip = "User choice: reference timeframe, not display timeframe. Yellow needs an aligned RB from this timeframe or higher. Colors remain consistent when switching charts.", group = G_GOLD)
bool requireReaction = input.bool(true, "Yellow requires a VAH / VAL reversal", tooltip = "All four types must align. With this ON, a recent candle must also touch a previously known VAH/VAL and close back inside the value area. Otherwise the box stays green.", group = G_GOLD)
int reactionMinutes = input.int(15, "Reversal memory (minutes)", minval = 1, maxval = 240, group = G_GOLD)
float reactionTolerance = input.float(1.0, "VAH / VAL touch tolerance (points)", minval = 0, maxval = 20, step = 0.25, group = G_GOLD)
bool directionalReaction = input.bool(true, "Reversal candle must close in the reversal direction", tooltip = "VAH: bearish candle closing below VAH. VAL: bullish candle closing above VAL. OFF: only a close back inside is required. No sequencing of the four confluences is required.", group = G_GOLD)

bool useFib = input.bool(true, "Include Fib STDV", group = G_FIB)
string fibTf = input.timeframe("5", "Construction timeframe", options = ["1", "5", "10", "15"], group = G_FIB)
string fibWindow = input.session("0000-0730", "Fixed UTC range window", group = G_FIB)
string expansionMode = input.string("Both sides", "Arm ±3 / ±3.5 / ±4 expansion", options = ["Both sides", "By multiplier sign"], group = G_FIB)
string fibRetention = input.string("Previous session", "Fib retention", options = ["Previous session", "Previous calendar day"], group = G_FIB)

bool useVwap = input.bool(true, "Include VWAP ±2 / ±3", group = G_VWAP)
string vwapAnchor = input.string("Futures 22:00 UTC", "Anchor", options = ["Futures 22:00 UTC", "Futures CME 18:00 New York", "RTH New York", "Daily UTC", "Custom UTC time"], group = G_VWAP)
int vwapHour = input.int(22, "Custom UTC hour", minval = 0, maxval = 23, group = G_VWAP)
int vwapMinute = input.int(0, "Custom UTC minute", minval = 0, maxval = 59, group = G_VWAP)
bool rthOnly = input.bool(true, "RTH: accumulate only 09:30–16:00 New York", group = G_VWAP)
int vwapWarmup = input.int(5, "Band warmup (minutes)", minval = 1, maxval = 120, group = G_VWAP)

bool useVp = input.bool(true, "Include VAH / VAL", group = G_VP)
int vpTicks = input.int(20, "Profile row size (ticks)", minval = 1, maxval = 400, tooltip = "Estimated from 1m high-low volume distribution, not actual volume traded at each price. NQ: 20 ticks = 5 points. POC never qualifies in this indicator.", group = G_VP)
float valueArea = input.float(70, "Value area (%)", minval = 50, maxval = 95, step = 1, group = G_VP)
int vpMaxRows = input.int(600, "Maximum profile rows", minval = 50, maxval = 2000, group = G_VP)
int vpWarmup = input.int(15, "Profile warmup (minutes after UTC midnight)", minval = 1, maxval = 240, group = G_VP)

bool useRb = input.bool(true, "Include RBs", group = G_RB)
bool rb5 = input.bool(true, "5 min", group = G_RB, inline = "rb")
bool rb10 = input.bool(true, "10 min", group = G_RB, inline = "rb")
bool rb15 = input.bool(true, "15 min", group = G_RB, inline = "rb")
float wickBodyRatio = input.float(2.0, "Wick ≥ N × body", minval = 0.5, maxval = 10, step = 0.1, group = G_RB)
float wickPercent = input.float(60, "Wick ≥ % of candle range", minval = 10, maxval = 95, step = 1, group = G_RB)
int leadBars = input.int(2, "Prior move: lookback candles", minval = 1, maxval = 10, group = G_RB)
string rbConfirm = input.string("Body", "Confirmation close beyond the", options = ["Body", "Extreme"], group = G_RB)
int rbLimit = input.int(40, "Maximum retained RBs", minval = 5, maxval = 100, group = G_RB)
int rbMaxDays = input.int(0, "RB expiration in days (0 = none)", minval = 0, maxval = 30, group = G_RB)

// Append new controls to preserve the original calibration / color input IDs.
string zoneSizing = input.string("Fixed height", "Zone sizing", options = ["Fixed height", "Cover confluence span"], tooltip = "Fixed height makes narrow resting price bands. Cover confluence span expands the height to contain the qualifying interval. Tolerance controls qualification separately.", group = G_BOX)
float mergeDistance = input.float(0.0, "Nearby zone merge distance (points)", minval = 0, maxval = 50, step = 0.25, tooltip = "An anchor already inside a resting band shares it. Increase to include nearby anchors. Existing price bounds never expand or move.", group = G_BOX)
int zoneMaxDays = input.int(0, "Zone expiration in days (0 = until invalidation)", minval = 0, maxval = 30, group = G_BOX)
bool showBroken = input.bool(false, "Show invalidated / expired zones", group = G_BOX)

string rbPlacement = input.string("Original anchor", "RB zone placement", options = ["Original anchor", "Beyond wick confluence"], tooltip = "Beyond wick confluence: RB stacks require an aligned Fib, VWAP or VAH/VAL level beyond the wick tip. Center a fixed-height box on the nearest such level. No arbitrary offset or future reversal price is used. Non-RB pairs retain their original placement.", group = G_BOX)
float minimumSweep = input.float(0.25, "Minimum distance beyond RB wick (points)", minval = 0.25, maxval = 100, step = 0.25, tooltip = "Applies only to Beyond wick confluence. The outer level must also be within Confluence tolerance of the wick tip. This is calibration, not a measured optimal entry distance.", group = G_BOX)
bool freshOnly = input.bool(false, "Hide zones after first return", tooltip = "Hide a zone after the first completed source candle overlaps its band after formation. Also skip creation if that candle already reaches the band. Does not claim the zone will reverse, and does not change price invalidation.", group = G_BOX)
bool showConfluenceText = input.bool(true, "Show confluence text", tooltip = "Show the concept families used at formation, plus contributing RB timeframes. A later yellow upgrade has its own text; earlier green text is preserved. No OTE is calculated.", group = G_BOX)
color confluenceTextColor = input.color(#ffffff, "Confluence text color", group = G_BOX)
string confluenceTextSize = input.string("Small", "Confluence text size", options = ["Tiny", "Small", "Normal", "Large"], group = G_BOX)
bool showDirectionSymbol = input.bool(true, "Show reversal side symbol (β / ρ)", tooltip = "β = support / buy-reversal area. ρ = resistance / sell-reversal area. Uses the zone's frozen source-anchor side, not a new trade signal. Independent of Show confluence text; text color and size apply to both.", group = G_BOX)

type Level
    float lo
    float hi
    int kind
    string caption
    int born
    int epoch
    int side
    bool active
    bool dead
    float multiplier
    float p0
    float leg

type Poi
    float lo
    float hi
    int kinds
    int members
    string details
    array<int> memberIds

type Candle
    int start
    int finish
    float o
    float h
    float l
    float c
    float v

type ZoneRecord
    int start
    int finish
    float lo
    float hi
    int kinds
    bool yellow
    bool live
    int lastSeen
    int side
    string anchors
    float killLo
    float killHi
    int yellowAt
    int touchedAt = na
    string sourceText = ""
    string yellowText = ""

type Reaction
    int day
    int upperAt
    float upperPrice
    int lowerAt
    float lowerPrice

type EngineState
    int asOf
    int day
    float referencePrice
    float sourceVolume
    float today0
    float today1
    int publishedDay
    int fibSets
    array<Level> fibs
    array<Level> vwapLevels
    array<Level> vpLevels
    array<Level> rbs
    array<float> profile
    float profileVolume
    int baseRow
    float mean
    float m2
    float weight
    int vwapEpoch
    bool vwapComplete
    bool accumulateVwap
    bool vwapReady
    bool vpComplete
    bool vpOverflow
    bool vpReady
    int evictedRb
    array<ZoneRecord> zones
    string zoneData

f_day(int t) =>
    timestamp("UTC", year(t, "UTC"), month(t, "UTC"), dayofmonth(t, "UTC"), 0, 0)

f_side(float p, float reference) =>
    p >= reference ? 1 : -1

f_level(float lo, float hi, int kind, string caption, int born, int epoch, int side) =>
    Level.new(lo, hi, kind, caption, born, epoch, side, true, false, na, na, na)

f_breached(Level level) =>
    level.side == 1 ? high >= level.hi + invalidation : low <= level.lo - invalidation

int rangeStart = int(str.tonumber(str.substring(fibWindow, 0, 2))) * 60 + int(str.tonumber(str.substring(fibWindow, 2, 4)))
int rangeEnd = int(str.tonumber(str.substring(fibWindow, 5, 7))) * 60 + int(str.tonumber(str.substring(fibWindow, 7, 9)))
float chartSeconds = timeframe.in_seconds()
float fibSeconds = timeframe.in_seconds(fibTf)
if barstate.isfirst
    if not chart.is_standard or not timeframe.isintraday or not array.includes(array.from(60, 300, 600, 900, 1800, 3600, 14400), int(chartSeconds))
        runtime.error("Use standard 1m, 5m, 10m, 15m, 30m, 1h or 4h candles.")
    if rangeEnd <= rangeStart or (rangeStart * 60) % int(fibSeconds) != 0 or (rangeEnd * 60) % int(fibSeconds) != 0
        runtime.error("The Fib window must stay within one UTC day and its boundaries must align with the construction timeframe.")

f_anchor(string tz, int h, int m) =>
    int localMinute = hour(time, tz) * 60 + minute(time, tz)
    int dayOffset = localMinute < h * 60 + m ? -1 : 0
    timestamp(tz, year(time, tz), month(time, tz), dayofmonth(time, tz) + dayOffset, h, m)

// Fib needs the complete construction window. RBs keep the original source-bar
// definition: aggregate the available trades, including sparse source candles.
// If the final minute is absent, publish that closed RB candle at the next bar.
f_aggregate(int minutes, bool requireFull) =>
    int duration = minutes * 60000
    int bucket = int(math.floor(time / duration)) * duration
    var Candle current = na
    var int count = 0
    var bool startsAtBoundary = false
    var bool emitted = false
    Candle completed = na
    if na(current) or current.start != bucket
        if not na(current) and not emitted and not requireFull
            completed := current.copy()
        current := Candle.new(bucket, bucket + duration, open, high, low, close, nz(volume))
        count := 1
        startsAtBoundary := time == bucket
        emitted := false
    else
        current.h := math.max(current.h, high)
        current.l := math.min(current.l, low)
        current.c := close
        current.v += nz(volume)
        count += 1
    if na(completed) and time_close == current.finish and (not requireFull or (startsAtBoundary and count == minutes))
        completed := current.copy()
        emitted := true
    completed

f_range(Candle completed) =>
    var int day = na
    var float hi = na
    var float lo = na
    var int hiTime = na
    var int loTime = na
    var bool completeStart = false
    var int completedCandles = 0
    var bool ready = false
    var float p0 = na
    var float p1 = na
    int d = f_day(time)
    if na(day) or d != day
        day := d
        hi := na
        lo := na
        hiTime := na
        loTime := na
        completeStart := false
        completedCandles := 0
        ready := false
        p0 := na
        p1 := na
    if not na(completed)
        int m = hour(completed.start, "UTC") * 60 + minute(completed.start, "UTC")
        if m >= rangeStart and m < rangeEnd
            completedCandles += 1
            float bh = math.max(completed.o, completed.c)
            float bl = math.min(completed.o, completed.c)
            if na(hi) or bh > hi
                hi := bh
                hiTime := completed.start
            if na(lo) or bl < lo
                lo := bl
                loTime := completed.start
            completeStart := completeStart or m == rangeStart
            if completed.finish == d + rangeEnd * 60000 and completeStart and completedCandles == (rangeEnd - rangeStart) * 60 / fibSeconds and hi > lo and hiTime != loTime
                p0 := hiTime < loTime ? hi : lo
                p1 := hiTime < loTime ? lo : hi
                ready := true
    [p0, p1, day, ready]

f_copyLevels(array<Level> levels) =>
    array<Level> copied = array.new<Level>()
    for level in levels
        array.push(copied, level.copy())
    copied

// Rejection candle is history[1], confirmation history[0]. This is the same
// body / wick / prior-move definition as v0.2, on completed aggregated candles.
f_updateRbs(Candle completed, array<Candle> history, array<Level> levels, string caption, bool enabled) =>
    if not na(completed)
        array.unshift(history, completed)
        if enabled and array.size(history) >= leadBars + 3
            Candle confirmation = array.get(history, 0)
            Candle rejection = array.get(history, 1)
            Candle before = array.get(history, 2)
            Candle earlier = array.get(history, 2 + leadBars)
            float bodyHi = math.max(rejection.o, rejection.c)
            float bodyLo = math.min(rejection.o, rejection.c)
            float body = math.max(bodyHi - bodyLo, syminfo.mintick)
            float span = rejection.h - rejection.l
            float upper = rejection.h - bodyHi
            float lower = bodyLo - rejection.l
            bool upMove = before.c > earlier.c
            bool downMove = before.c < earlier.c
            bool rejectHigh = span > 0 and upper >= wickBodyRatio * body and upper >= span * wickPercent / 100.0
            bool rejectLow = span > 0 and lower >= wickBodyRatio * body and lower >= span * wickPercent / 100.0
            bool reverseDown = confirmation.c < confirmation.o and confirmation.c < (rbConfirm == "Body" ? bodyLo : rejection.l)
            bool reverseUp = confirmation.c > confirmation.o and confirmation.c > (rbConfirm == "Body" ? bodyHi : rejection.h)
            bool upperRb = upMove and rejectHigh and reverseDown and confirmation.h < rejection.h + invalidation
            bool lowerRb = downMove and rejectLow and reverseUp and confirmation.l > rejection.l - invalidation
            if upperRb or lowerRb
                array.push(levels, f_level(upperRb ? bodyHi : rejection.l, upperRb ? rejection.h : bodyLo, 4, caption, confirmation.finish, rejection.start, upperRb ? 1 : -1))
        while array.size(history) > leadBars + 3
            array.pop(history)
    array.size(history)

// The snapshot is copied BEFORE this minute is updated. It therefore contains
// completed-minute data on every chart, without relying on barstate.isconfirmed
// inside request.security(). A compact immutable zone snapshot is available
// on every source bar, including historical replay bars.

f_countKinds(array<Level> candidates, array<int> sortedIndices, int first, int last) =>
    bool a = false
    bool b = false
    bool c = false
    bool d = false
    for j = first to last
        int k = array.get(candidates, array.get(sortedIndices, j)).kind
        a := a or k == 1
        b := b or k == 2
        c := c or k == 3
        d := d or k == 4
    (a ? 1 : 0) + (b ? 1 : 0) + (c ? 1 : 0) + (d ? 1 : 0)

// Sweep possible minimum upper edges. For points: max(price)-min(price) <=
// tolerance, never transitive chaining. An RB spanning several separate groups
// can participate in each. Drop subsets, then retain zones nearest current price.
f_findPois(array<Level> candidates, float reference) =>
    array<Poi> zones = array.new<Poi>()
    array<float> highs = array.new_float()
    for level in candidates
        array.push(highs, level.hi)
    array<int> sortedIndices = array.sort_indices(highs, order.ascending)
    if array.size(sortedIndices) >= 2
        for seedIndex in sortedIndices
            float anchor = array.get(candidates, seedIndex).hi
            array<int> matched = array.new_int()
            float tightLo = na
            float tightHi = na
            for j = 0 to array.size(candidates) - 1
                Level member = array.get(candidates, j)
                if member.hi >= anchor and member.lo <= anchor + tolerance
                    array.push(matched, j)
                    tightLo := na(tightLo) ? member.lo : math.max(tightLo, member.lo)
                    tightHi := na(tightHi) ? member.hi : math.min(tightHi, member.hi)
            int kinds = f_countKinds(candidates, matched, 0, array.size(matched) - 1)
            int count = distinctKinds ? kinds : array.size(matched)
            bool subset = false
            if count >= minimumConcepts
                for previous in zones
                    bool contained = true
                    for id in matched
                        contained := contained and array.includes(previous.memberIds, id)
                    subset := subset or contained
            if count >= minimumConcepts and not subset
                string details = ""
                array.push(zones, Poi.new(math.min(tightLo, tightHi), math.max(tightLo, tightHi), kinds, array.size(matched), details, matched))
    array<float> distances = array.new_float()
    for zone in zones
        array.push(distances, math.max(zone.lo - reference, math.max(reference - zone.hi, 0.0)))
    array<int> nearest = array.sort_indices(distances, order.ascending)
    array<Poi> selected = array.new<Poi>()
    for id in nearest
        if array.size(selected) < maxPoi
            array.push(selected, array.get(zones, id))
    selected

f_copyZones(array<ZoneRecord> records) =>
    array<ZoneRecord> copied = array.new<ZoneRecord>()
    for record in records
        array.push(copied, record.copy())
    copied

// Use the profile known BEFORE this candle; never invent a rejection of a
// profile edge reconstructed from that same candle's volume.
f_updateReaction(Reaction reaction, array<Level> levels, int day) =>
    if na(reaction.day) or reaction.day != day
        reaction.day := day
        reaction.upperAt := na
        reaction.lowerAt := na
        reaction.upperPrice := na
        reaction.lowerPrice := na
    for level in levels
        if level.epoch == day and level.active and not level.dead
            bool touch = high >= level.lo - reactionTolerance and low <= level.hi + reactionTolerance
            bool fromVah = level.caption == "VAH ~" and touch and close < level.lo and (not directionalReaction or close < open)
            bool fromVal = level.caption == "VAL ~" and touch and close > level.hi and (not directionalReaction or close > open)
            if fromVah
                reaction.upperAt := time_close
                reaction.upperPrice := level.lo
            if fromVal
                reaction.lowerAt := time_close
                reaction.lowerPrice := level.hi
    reaction

f_hasReaction(Level level, Reaction reaction, int now) =>
    int stamp = level.caption == "VAH ~" ? reaction.upperAt : reaction.lowerAt
    float price = level.caption == "VAH ~" ? reaction.upperPrice : reaction.lowerPrice
    level.kind == 3 and level.epoch == reaction.day and not na(stamp) and now >= stamp and now - stamp <= reactionMinutes * 60000 and math.abs(level.lo - price) <= tolerance

f_yellow(Poi zone, array<Level> candidates, Reaction reaction, int now) =>
    bool higherRb = false
    bool reversal = not requireReaction
    for id in zone.memberIds
        Level member = array.get(candidates, id)
        if member.kind == 4
            int seconds = member.caption == "RB 15m" ? 900 : member.caption == "RB 10m" ? 600 : member.caption == "RB 5m" ? 300 : 0
            higherRb := higherRb or seconds >= timeframe.in_seconds(yellowRbTf)
        if member.kind == 3
            reversal := reversal or f_hasReaction(member, reaction, now)
    zone.kinds == 4 and higherRb and reversal

f_candidates(array<Level> source, array<Level> candidates, bool enabled) =>
    if enabled
        for level in source
            if level.active and not level.dead and (level.kind != 3 or level.caption == "VAH ~" or level.caption == "VAL ~")
                array.push(candidates, level)
    array.size(candidates)

// Prefer a fixed Fib price, then an already formed RB wick. With VP + VWAP,
// freeze the qualifying profile edge. Never anchor a resting zone to a moving
// average's new price on every candle.
f_anchorMember(Poi zone, array<Level> candidates) =>
    int selected = array.get(zone.memberIds, 0)
    int bestRank = 99
    float closest = na
    float middle = (zone.lo + zone.hi) / 2
    for id in zone.memberIds
        Level member = array.get(candidates, id)
        int rank = member.kind == 1 ? 0 : member.kind == 4 ? 1 : member.kind == 3 ? 2 : 3
        float distance = math.abs((member.lo + member.hi) / 2 - middle)
        if rank < bestRank or (rank == bestRank and (na(closest) or distance < closest))
            selected := id
            bestRank := rank
            closest := distance
    array.get(candidates, selected)

f_anchorKey(Level anchor) =>
    "|" + str.tostring(anchor.kind) + ":" + anchor.caption + ":" + str.tostring(anchor.epoch) + "|"

// Record only the known contributors, never infer a concept from the box grade.
f_confluenceText(Poi zone, array<Level> candidates) =>
    bool fib = false
    bool vwap = false
    bool vah = false
    bool val = false
    bool rbFive = false
    bool rbTen = false
    bool rbFifteen = false
    for id in zone.memberIds
        Level member = array.get(candidates, id)
        fib := fib or member.kind == 1
        vwap := vwap or member.kind == 2
        vah := vah or (member.kind == 3 and member.caption == "VAH ~")
        val := val or (member.kind == 3 and member.caption == "VAL ~")
        rbFive := rbFive or (member.kind == 4 and member.caption == "RB 5m")
        rbTen := rbTen or (member.kind == 4 and member.caption == "RB 10m")
        rbFifteen := rbFifteen or (member.kind == 4 and member.caption == "RB 15m")
    string caption = fib ? "STDV" : ""
    if vwap
        caption += (caption == "" ? "" : " | ") + "VWAP"
    if vah or val
        caption += (caption == "" ? "" : " | ") + (vah and val ? "VAH/VAL" : vah ? "VAH" : "VAL")
    if rbFive or rbTen or rbFifteen
        string frames = rbFive ? "5m" : ""
        frames += rbTen ? (frames == "" ? "" : "/") + "10m" : ""
        frames += rbFifteen ? (frames == "" ? "" : "/") + "15m" : ""
        caption += (caption == "" ? "" : " | ") + "RB " + frames
    caption

f_rbSeconds(Level level) =>
    level.caption == "RB 15m" ? 900 : level.caption == "RB 10m" ? 600 : 300

// Optional placement uses a REAL aligned level outside a formed wick. If an RB
// stack has no such level, skip it; do not manufacture a sweep price.
f_zoneAnchor(Poi zone, array<Level> candidates) =>
    Level anchor = f_anchorMember(zone, candidates)
    float price = anchor.kind == 4 ? math.max(anchor.lo, math.min(anchor.hi, (zone.lo + zone.hi) / 2)) : (anchor.lo + anchor.hi) / 2
    bool valid = true
    if rbPlacement == "Beyond wick confluence"
        bool hasRb = false
        float gap = na
        int seconds = 0
        int bestKind = 99
        for id in zone.memberIds
            Level rb = array.get(candidates, id)
            if rb.kind == 4
                hasRb := true
                for pointId in zone.memberIds
                    Level point = array.get(candidates, pointId)
                    if point.kind != 4
                        float distance = rb.side == 1 ? point.lo - rb.hi : rb.lo - point.hi
                        int frame = f_rbSeconds(rb)
                        bool better = na(gap) or distance < gap or (distance == gap and (frame > seconds or (frame == seconds and point.kind < bestKind)))
                        if distance >= math.max(minimumSweep, syminfo.mintick) and distance <= tolerance and distance < invalidation and better
                            gap := distance
                            seconds := frame
                            bestKind := point.kind
                            anchor := rb
                            price := (point.lo + point.hi) / 2
        valid := not hasRb or not na(gap)
    [anchor, price, valid]

// Confluence CREATES a resting price area. It does not have to keep following
// VWAP / profile to stay on the chart. Only a price breach (or optional expiry)
// retires it. Each anchor is consumed once, including after invalidation.
f_updateZones(array<ZoneRecord> records, array<Level> candidates, Reaction reaction, int now, float reference) =>
    bool changed = false
    array<Poi> current = f_findPois(candidates, reference)
    for record in records
        if record.live and record.start < now and na(record.touchedAt) and low <= record.hi and high >= record.lo
            record.touchedAt := now
            changed := true
        bool expired = zoneMaxDays > 0 and now - record.start >= zoneMaxDays * DAY_MS
        bool breached = record.side == 1 ? high >= record.killHi : low <= record.killLo
        if record.live and record.start < now and (breached or expired)
            record.live := false
            record.finish := now
            changed := true
    for zone in current
        [anchor, anchorPrice, placementValid] = f_zoneAnchor(zone, candidates)
        if not placementValid
            continue
        string key = f_anchorKey(anchor)
        bool sweepPlacement = rbPlacement == "Beyond wick confluence" and anchor.kind == 4
        // In sweep mode the old wick is context, not the new price band.
        float rawLo = sweepPlacement ? anchorPrice : math.min(anchor.lo, zone.lo)
        float rawHi = sweepPlacement ? anchorPrice : math.max(anchor.hi, zone.hi)
        float middle = zoneSizing == "Fixed height" ? anchorPrice : (rawLo + rawHi) / 2
        float height = zoneSizing == "Fixed height" ? minimumHeight : math.max(minimumHeight, rawHi - rawLo)
        float bottom = math.floor((middle - height / 2 - boxPadding) / syminfo.mintick) * syminfo.mintick
        float top = math.ceil((middle + height / 2 + boxPadding) / syminfo.mintick) * syminfo.mintick
        bool yellow = f_yellow(zone, candidates, reaction, now)
        int found = -1
        float closest = na
        bool consumed = false
        if array.size(records) > 0
            for i = 0 to array.size(records) - 1
                ZoneRecord record = array.get(records, i)
                bool sameAnchor = str.contains(record.anchors, key)
                consumed := consumed or sameAnchor
                float distance = math.abs(middle - (record.lo + record.hi) / 2)
                bool nearby = anchorPrice >= record.lo - mergeDistance and anchorPrice <= record.hi + mergeDistance
                if record.live and (sameAnchor or nearby) and (na(closest) or sameAnchor or distance < closest)
                    found := i
                    closest := sameAnchor ? -1.0 : distance
        if found >= 0
            ZoneRecord record = array.get(records, found)
            if not str.contains(record.anchors, key)
                record.anchors += key
            bool nearby = anchorPrice >= record.lo - mergeDistance and anchorPrice <= record.hi + mergeDistance
            if nearby
                record.lastSeen := now
                if zone.kinds > record.kinds
                    record.kinds := zone.kinds
                    changed := true
                if yellow and not record.yellow
                    record.yellow := true
                    record.yellowAt := now
                    record.yellowText := f_confluenceText(zone, candidates)
                    changed := true
        bool awaitingReturn = anchor.side == 1 ? high < bottom : low > top
        if found < 0 and not consumed and (not freshOnly or awaitingReturn)
            int side = anchor.side
            ZoneRecord created = ZoneRecord.new(now, now, bottom, top, zone.kinds, yellow, true, now, side, key, anchor.lo - invalidation, anchor.hi + invalidation, yellow ? now : na)
            created.sourceText := f_confluenceText(zone, candidates)
            created.yellowText := yellow ? created.sourceText : ""
            array.push(records, created)
            changed := true
    int index = array.size(records) - 1
    while index >= 0
        ZoneRecord record = array.get(records, index)
        if not record.live and record.finish < now - zoneDays * DAY_MS
            array.remove(records, index)
            changed := true
        index -= 1
    while array.size(records) > zoneLimit
        array.shift(records)
        changed := true
    changed

// Primitive, cached history for Bar Replay. Large mutable level/profile
// collections stay inside the 1m engine. Anchor ledgers are internal only.
f_packZones(array<ZoneRecord> records) =>
    string packed = ""
    for record in records
        packed += str.tostring(record.start) + ";" + str.tostring(record.finish) + ";" + str.tostring(record.lo, "#.########") + ";" + str.tostring(record.hi, "#.########") + ";" + str.tostring(record.kinds) + ";" + (record.yellow ? "1" : "0") + ";" + (record.live ? "1" : "0") + ";" + str.tostring(record.side) + ";" + str.tostring(record.killLo, "#.########") + ";" + str.tostring(record.killHi, "#.########") + ";" + str.tostring(record.yellowAt) + ";" + str.tostring(record.touchedAt) + ";" + record.sourceText + ";" + record.yellowText + "\n"
    packed

f_unpackZones(string packed) =>
    array<ZoneRecord> records = array.new<ZoneRecord>()
    for row in str.split(packed, "\n")
        if row != ""
            array<string> fields = str.split(row, ";")
            if array.size(fields) != 14
                runtime.error("Invalid internal replay snapshot.")
            int start = int(str.tonumber(array.get(fields, 0)))
            int finish = int(str.tonumber(array.get(fields, 1)))
            float bottom = str.tonumber(array.get(fields, 2))
            float top = str.tonumber(array.get(fields, 3))
            int kinds = int(str.tonumber(array.get(fields, 4)))
            bool yellow = array.get(fields, 5) == "1"
            bool live = array.get(fields, 6) == "1"
            int side = int(str.tonumber(array.get(fields, 7)))
            float killLo = str.tonumber(array.get(fields, 8))
            float killHi = str.tonumber(array.get(fields, 9))
            int yellowAt = int(str.tonumber(array.get(fields, 10)))
            int touchedAt = int(str.tonumber(array.get(fields, 11)))
            string sourceText = array.get(fields, 12)
            string yellowText = array.get(fields, 13)
            array.push(records, ZoneRecord.new(start, finish, bottom, top, kinds, yellow, live, na, side, "", killLo, killHi, yellowAt, touchedAt, sourceText, yellowText))
    records

f_engine(bool audit = false) =>
    var array<Level> fibs = array.new<Level>()
    var array<int> fibEpochs = array.new_int()
    var int publishedDay = na
    var float today0 = na
    var float today1 = na
    var array<Level> vwapLevels = array.new<Level>()
    var int vwapEpoch = na
    var float weight = 0.0
    var float mean = na
    var float m2 = 0.0
    var bool vwapComplete = false
    var bool accumulateVwap = false
    var bool vwapReady = false
    var array<float> profile = array.new_float()
    var int baseRow = na
    var bool vpOverflow = false
    var bool vpComplete = false
    var float profileVolume = 0.0
    var array<Level> vpLevels = array.new<Level>()
    var bool vpReady = false
    var array<Level> rbs = array.new<Level>()
    var array<Candle> history5 = array.new<Candle>()
    var array<Candle> history10 = array.new<Candle>()
    var array<Candle> history15 = array.new<Candle>()
    var int evictedRb = 0
    var array<ZoneRecord> records = array.new<ZoneRecord>()
    var Reaction reaction = Reaction.new(na, na, na, na, na)
    var string zoneData = ""
    var int asOf = na
    var int stateDay = na
    var float referencePrice = na
    var float sourceVolume = 0.0
    bool exportSnapshot = true
    EngineState snapshot = na
    if exportSnapshot and not na(asOf)
        snapshot := EngineState.new(asOf, stateDay, referencePrice, sourceVolume, today0, today1, publishedDay, array.size(fibEpochs), audit ? f_copyLevels(fibs) : na, audit ? f_copyLevels(vwapLevels) : na, audit ? f_copyLevels(vpLevels) : na, audit ? f_copyLevels(rbs) : na, audit ? array.copy(profile) : na, profileVolume, baseRow, mean, m2, weight, vwapEpoch, vwapComplete, accumulateVwap, vwapReady, vpComplete, vpOverflow, vpReady, evictedRb, audit ? f_copyZones(records) : na, zoneData)
    int utcDay = f_day(time)
    bool newDay = na(stateDay) or utcDay != stateDay
    bool calendarRetention = fibRetention == "Previous calendar day"
    [range0, range1, rangeDay, rangeReady] = f_range(f_aggregate(int(fibSeconds / 60), true))
    if newDay
        today0 := na
        today1 := na
        if calendarRetention
            int i = array.size(fibs) - 1
            while i >= 0
                if array.get(fibs, i).epoch < utcDay - DAY_MS
                    array.remove(fibs, i)
                i -= 1
            while array.size(fibEpochs) > 0 and array.get(fibEpochs, 0) < utcDay - DAY_MS
                array.shift(fibEpochs)

    if rangeReady and rangeDay == utcDay and (na(publishedDay) or publishedDay != rangeDay)
        today0 := range0
        today1 := range1
        publishedDay := rangeDay
        array<float> multipliers = array.from(2.0, 2.25, 2.5, -2.0, -2.25, -2.5, 3.0, 3.5, 4.0, -3.0, -3.5, -4.0)
        for multiplier in multipliers
            float price = range0 + multiplier * (range1 - range0)
            string signedName = (multiplier > 0 ? "+" : "") + str.tostring(multiplier, "#.##")
            Level level = f_level(price, price, 1, signedName, utcDay + rangeEnd * 60000, utcDay, f_side(price, close))
            level.multiplier := multiplier
            level.p0 := range0
            level.leg := range1 - range0
            level.active := math.abs(multiplier) <= 2.5
            array.push(fibs, level)
        if not array.includes(fibEpochs, utcDay)
            array.push(fibEpochs, utcDay)
        if not calendarRetention
            while array.size(fibEpochs) > 2
                int stale = array.shift(fibEpochs)
                int k = array.size(fibs) - 1
                while k >= 0
                    if array.get(fibs, k).epoch == stale
                        array.remove(fibs, k)
                    k -= 1

    for level in fibs
        bool justArmed = false
        if not level.active and not level.dead
            float coordinate = (close - level.p0) / level.leg
            bool crossed = expansionMode == "Both sides" ? (coordinate > 2.5 or coordinate < -2.5) : (level.multiplier > 0 ? coordinate > 2.5 : coordinate < -2.5)
            if crossed
                level.active := true
                level.side := f_side(level.lo, close)
                justArmed := true
        if level.active and not level.dead and not justArmed and level.born <= time and f_breached(level)
            level.dead := true

    int anchorKey = switch vwapAnchor
        "Futures CME 18:00 New York" => f_anchor("America/New_York", 18, 0)
        "RTH New York" => f_anchor("America/New_York", 9, 30)
        "Daily UTC" => utcDay
        "Custom UTC time" => f_anchor("UTC", vwapHour, vwapMinute)
        => f_anchor("UTC", 22, 0)
    bool inRth = not na(time(timeframe.period, "0930-1600:23456", "America/New_York"))
    accumulateVwap := vwapAnchor != "RTH New York" or not rthOnly or inRth
    if accumulateVwap
        if na(vwapEpoch) or anchorKey != vwapEpoch
            vwapEpoch := anchorKey
            weight := 0.0
            mean := na
            m2 := 0.0
            // An anchor can fall in a legitimate exchange closure (e.g. fixed 22:00
            // UTC during winter CME maintenance). A loaded bar before the boundary
            // proves we did not simply start the dataset midway through the session.
            vwapComplete := time == anchorKey or (not na(time_close[1]) and time_close[1] <= anchorKey)
            array.clear(vwapLevels)
        if not na(volume) and volume > 0
            float newWeight = weight + volume
            float delta = na(mean) ? 0.0 : hlc3 - mean
            float newMean = na(mean) ? hlc3 : mean + volume / newWeight * delta
            m2 += volume * delta * (hlc3 - newMean)
            mean := newMean
            weight := newWeight
    float deviation = weight > 0 ? math.sqrt(math.max(m2 / weight, 0.0)) : na
    vwapReady := accumulateVwap and vwapComplete and weight > 0 and deviation >= syminfo.mintick and time_close >= vwapEpoch + vwapWarmup * 60000
    array<float> vwapPrices = array.from(mean + 2 * deviation, mean - 2 * deviation, mean + 3 * deviation, mean - 3 * deviation)
    if vwapReady and array.size(vwapLevels) == 0
        array<string> names = array.from("VWAP +2 SD", "VWAP -2 SD", "VWAP +3 SD", "VWAP -3 SD")
        for i = 0 to 3
            float price = array.get(vwapPrices, i)
            array.push(vwapLevels, f_level(price, price, 2, array.get(names, i), time_close, vwapEpoch, f_side(price, close)))
    else if vwapReady
        for i = 0 to array.size(vwapLevels) - 1
            Level level = array.get(vwapLevels, i)
            if invalidateMoving and f_breached(level)
                level.dead := true
            level.lo := array.get(vwapPrices, i)
            level.hi := level.lo
            if not invalidateMoving
                level.side := f_side(level.lo, close)

    f_updateReaction(reaction, vpLevels, utcDay)

    float rowSize = vpTicks * syminfo.mintick
    // Keep the daily state independent of the dataset's final date. Only the
    // current day's buckets are retained; this also preserves a cold-reload
    // snapshot at midnight or a market reopening.
    bool profileDay = true
    if newDay
        array.clear(profile)
        array.clear(vpLevels)
        baseRow := na
        vpOverflow := false
        vpComplete := time == utcDay or (not na(time_close[1]) and time_close[1] <= utcDay)
        profileVolume := 0.0
    if profileDay and not vpOverflow and not na(volume) and volume > 0
        int bottomRow = int(math.floor(low / rowSize))
        int topRow = int(math.floor(high / rowSize))
        int nextBase = na(baseRow) ? bottomRow : math.min(baseRow, bottomRow)
        int nextTop = na(baseRow) ? topRow : math.max(baseRow + array.size(profile) - 1, topRow)
        if nextTop - nextBase + 1 > vpMaxRows
            vpOverflow := true
            array.clear(vpLevels)
        else
            if na(baseRow)
                baseRow := bottomRow
            while baseRow > nextBase
                array.unshift(profile, 0.0)
                baseRow -= 1
            while array.size(profile) < nextTop - baseRow + 1
                array.push(profile, 0.0)
            for row = bottomRow to topRow
                float overlap = math.max(0.0, math.min(high, (row + 1) * rowSize) - math.max(low, row * rowSize))
                float allocated = high == low ? volume : volume * overlap / (high - low)
                int index = row - baseRow
                array.set(profile, index, array.get(profile, index) + allocated)
            profileVolume += volume

    vpReady := profileDay and vpComplete and not vpOverflow and profileVolume > 0 and time_close >= utcDay + vpWarmup * 60000
    float poc = na
    float vah = na
    float val = na
    if vpReady
        float peak = -1.0
        int pocIndex = 0
        for i = 0 to array.size(profile) - 1
            float v = array.get(profile, i)
            if v > peak
                peak := v
                pocIndex := i
        int left = pocIndex
        int right = pocIndex
        float captured = peak
        float target = profileVolume * valueArea / 100.0
        while captured < target and (left > 0 or right < array.size(profile) - 1)
            float lv = left > 0 ? array.get(profile, left - 1) : -1.0
            float rv = right < array.size(profile) - 1 ? array.get(profile, right + 1) : -1.0
            if lv >= rv and left > 0
                left -= 1
                captured += lv
            if rv >= lv and right < array.size(profile) - 1
                right += 1
                captured += rv
        poc := (baseRow + pocIndex + 0.5) * rowSize
        vah := (baseRow + right + 1) * rowSize
        val := (baseRow + left) * rowSize
        array<float> prices = array.from(vah, val, poc)
        if array.size(vpLevels) == 0
            array<string> names = array.from("VAH ~", "VAL ~", "POC ~")
            for i = 0 to 2
                float price = array.get(prices, i)
                array.push(vpLevels, f_level(price, price, 3, array.get(names, i), time_close, utcDay, f_side(price, close)))
        else
            for i = 0 to 2
                Level level = array.get(vpLevels, i)
                if invalidateMoving and f_breached(level)
                    level.dead := true
                level.lo := array.get(prices, i)
                level.hi := level.lo
                if not invalidateMoving
                    level.side := f_side(level.lo, close)

    f_updateRbs(f_aggregate(5, false), history5, rbs, "RB 5m", rb5)
    f_updateRbs(f_aggregate(10, false), history10, rbs, "RB 10m", rb10)
    f_updateRbs(f_aggregate(15, false), history15, rbs, "RB 15m", rb15)
    for level in rbs
        if not level.dead and level.born <= time and f_breached(level)
            level.dead := true
    int rbIndex = array.size(rbs) - 1
    while rbIndex >= 0
        Level level = array.get(rbs, rbIndex)
        bool expired = rbMaxDays > 0 and time_close - level.epoch >= rbMaxDays * DAY_MS
        if expired or (level.dead and not showDead)
            array.remove(rbs, rbIndex)
        rbIndex -= 1
    while array.size(rbs) > rbLimit
        array.shift(rbs)
        evictedRb += 1
    array<Level> candidates = array.new<Level>()
    f_candidates(fibs, candidates, useFib)
    f_candidates(vwapLevels, candidates, useVwap and vwapReady)
    f_candidates(vpLevels, candidates, useVp and vpReady)
    f_candidates(rbs, candidates, useRb)
    bool changed = f_updateZones(records, candidates, reaction, time_close, close)
    if changed
        zoneData := f_packZones(records)
    asOf := time_close
    stateDay := utcDay
    referencePrice := close
    sourceVolume := nz(volume)
    snapshot

f_confluenceTextSize() =>
    switch confluenceTextSize
        "Tiny" => size.tiny
        "Normal" => size.normal
        "Large" => size.large
        => size.small

f_boxCaption(ZoneRecord record, bool yellow) =>
    string caption = showDirectionSymbol ? (record.side == 1 ? "ρ" : "β") : ""
    string sources = yellow ? record.yellowText : record.sourceText
    if showConfluenceText and sources != ""
        caption += (caption == "" ? "" : "  ") + sources
    caption

[snapshot] = request.security(syminfo.tickerid, "1", [f_engine()], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off, calc_bars_count = engineBars)

// Process every available chart bar, including historical replay cursors.
// Rebuild objects only when visible zones change; otherwise move their right
// edges with completed source time. Start and price bounds remain frozen.
var array<ZoneRecord> zoneState = array.new<ZoneRecord>()
var string appliedData = na
var string drawingSignature = na
var array<box> drawnBoxes = array.new<box>()
var array<box> projectedBoxes = array.new<box>()
if not na(snapshot)
    if na(appliedData) or snapshot.zoneData != appliedData
        zoneState := f_unpackZones(snapshot.zoneData)
        appliedData := snapshot.zoneData
    array<ZoneRecord> active = array.new<ZoneRecord>()
    array<float> distances = array.new_float()
    for record in zoneState
        if record.live and (not freshOnly or na(record.touchedAt))
            array.push(active, record)
            array.push(distances, math.max(record.lo - snapshot.referencePrice, math.max(snapshot.referencePrice - record.hi, 0.0)))
    array<ZoneRecord> visible = array.new<ZoneRecord>()
    for id in array.sort_indices(distances, order.ascending)
        if array.size(visible) < maxPoi
            array.push(visible, array.get(active, id))
    if showBroken
        int index = array.size(zoneState) - 1
        while index >= 0 and array.size(visible) < 150
            ZoneRecord record = array.get(zoneState, index)
            if not record.live and (not freshOnly or na(record.touchedAt))
                array.push(visible, record)
            index -= 1
    string signature = f_packZones(visible)
    if na(drawingSignature) or signature != drawingSignature
        for item in drawnBoxes
            box.delete(item)
        array.clear(drawnBoxes)
        array.clear(projectedBoxes)
        // Yellow is drawn last so weaker overlapping zones cannot cover it.
        for layer = 0 to 1
            for record in visible
                int rightEdge = record.live ? snapshot.asOf + boxMinutes * 60000 : record.finish
                if layer == 0 and (not record.yellow or record.yellowAt > record.start)
                    int greenEnd = record.yellow ? record.yellowAt : rightEdge
                    box item = box.new(left = record.start, top = record.hi, right = greenEnd, bottom = record.lo, xloc = xloc.bar_time, bgcolor = color.new(greenColor, boxOpacity), border_color = greenColor, border_width = borderWidth, text = f_boxCaption(record, false), text_color = confluenceTextColor, text_size = f_confluenceTextSize(), text_halign = text.align_center, text_valign = text.align_center)
                    array.push(drawnBoxes, item)
                    if record.live and not record.yellow
                        array.push(projectedBoxes, item)
                if layer == 1 and record.yellow
                    box item = box.new(left = record.yellowAt, top = record.hi, right = rightEdge, bottom = record.lo, xloc = xloc.bar_time, bgcolor = color.new(yellowColor, boxOpacity), border_color = yellowColor, border_width = borderWidth, text = f_boxCaption(record, true), text_color = confluenceTextColor, text_size = f_confluenceTextSize(), text_halign = text.align_center, text_valign = text.align_center)
                    array.push(drawnBoxes, item)
                    if record.live
                        array.push(projectedBoxes, item)
        drawingSignature := signature
    for item in projectedBoxes
        box.set_right(item, snapshot.asOf + boxMinutes * 60000)
