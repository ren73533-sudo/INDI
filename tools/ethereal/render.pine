f_confluenceTextSize() =>
    switch confluenceTextSize
        "Tiny" => size.tiny
        "Normal" => size.normal
        "Large" => size.large
        => size.small

f_boxCaption(ZoneRecord record, bool yellow) =>
    string caption = showDirectionSymbol ? (record.side == 1 ? "ρ" : "β") : ""
    string sources = yellow ? record.yellowText : record.sourceText
    if showConfluenceText and sources != ""
        caption += (caption == "" ? "" : "  ") + sources
    caption

[snapshot] = request.security(syminfo.tickerid, "1", [f_engine()], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off, calc_bars_count = engineBars)

// Process every available chart bar, including historical replay cursors.
// Rebuild objects only when visible zones change; otherwise move their right
// edges with completed source time. Start and price bounds remain frozen.
var array<ZoneRecord> zoneState = array.new<ZoneRecord>()
var string appliedData = na
var string drawingSignature = na
var array<box> drawnBoxes = array.new<box>()
var array<box> projectedBoxes = array.new<box>()
if not na(snapshot)
    if na(appliedData) or snapshot.zoneData != appliedData
        zoneState := f_unpackZones(snapshot.zoneData)
        appliedData := snapshot.zoneData
    array<ZoneRecord> active = array.new<ZoneRecord>()
    array<float> distances = array.new_float()
    for record in zoneState
        if record.live and (not freshOnly or na(record.touchedAt))
            array.push(active, record)
            array.push(distances, math.max(record.lo - snapshot.referencePrice, math.max(snapshot.referencePrice - record.hi, 0.0)))
    array<ZoneRecord> visible = array.new<ZoneRecord>()
    for id in array.sort_indices(distances, order.ascending)
        if array.size(visible) < maxPoi
            array.push(visible, array.get(active, id))
    if showBroken
        int index = array.size(zoneState) - 1
        while index >= 0 and array.size(visible) < 150
            ZoneRecord record = array.get(zoneState, index)
            if not record.live and (not freshOnly or na(record.touchedAt))
                array.push(visible, record)
            index -= 1
    string signature = f_packZones(visible)
    if na(drawingSignature) or signature != drawingSignature
        for item in drawnBoxes
            box.delete(item)
        array.clear(drawnBoxes)
        array.clear(projectedBoxes)
        // Yellow is drawn last so weaker overlapping zones cannot cover it.
        for layer = 0 to 1
            for record in visible
                int rightEdge = record.live ? snapshot.asOf + boxMinutes * 60000 : record.finish
                if layer == 0 and (not record.yellow or record.yellowAt > record.start)
                    int greenEnd = record.yellow ? record.yellowAt : rightEdge
                    box item = box.new(left = record.start, top = record.hi, right = greenEnd, bottom = record.lo, xloc = xloc.bar_time, bgcolor = color.new(greenColor, boxOpacity), border_color = greenColor, border_width = borderWidth, text = f_boxCaption(record, false), text_color = confluenceTextColor, text_size = f_confluenceTextSize(), text_halign = text.align_center, text_valign = text.align_center)
                    array.push(drawnBoxes, item)
                    if record.live and not record.yellow
                        array.push(projectedBoxes, item)
                if layer == 1 and record.yellow
                    box item = box.new(left = record.yellowAt, top = record.hi, right = rightEdge, bottom = record.lo, xloc = xloc.bar_time, bgcolor = color.new(yellowColor, boxOpacity), border_color = yellowColor, border_width = borderWidth, text = f_boxCaption(record, true), text_color = confluenceTextColor, text_size = f_confluenceTextSize(), text_halign = text.align_center, text_valign = text.align_center)
                    array.push(drawnBoxes, item)
                    if record.live
                        array.push(projectedBoxes, item)
        drawingSignature := signature
    for item in projectedBoxes
        box.set_right(item, snapshot.asOf + boxMinutes * 60000)
