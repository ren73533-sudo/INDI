f_copyZones(array<ZoneRecord> records) =>
    array<ZoneRecord> copied = array.new<ZoneRecord>()
    for record in records
        array.push(copied, record.copy())
    copied

// Use the profile known BEFORE this candle; never invent a rejection of a
// profile edge reconstructed from that same candle's volume.
f_updateReaction(Reaction reaction, array<Level> levels, int day) =>
    if na(reaction.day) or reaction.day != day
        reaction.day := day
        reaction.upperAt := na
        reaction.lowerAt := na
        reaction.upperPrice := na
        reaction.lowerPrice := na
    for level in levels
        if level.epoch == day and level.active and not level.dead
            bool touch = high >= level.lo - reactionTolerance and low <= level.hi + reactionTolerance
            bool fromVah = level.caption == "VAH ~" and touch and close < level.lo and (not directionalReaction or close < open)
            bool fromVal = level.caption == "VAL ~" and touch and close > level.hi and (not directionalReaction or close > open)
            if fromVah
                reaction.upperAt := time_close
                reaction.upperPrice := level.lo
            if fromVal
                reaction.lowerAt := time_close
                reaction.lowerPrice := level.hi
    reaction

f_hasReaction(Level level, Reaction reaction, int now) =>
    int stamp = level.caption == "VAH ~" ? reaction.upperAt : reaction.lowerAt
    float price = level.caption == "VAH ~" ? reaction.upperPrice : reaction.lowerPrice
    level.kind == 3 and level.epoch == reaction.day and not na(stamp) and now >= stamp and now - stamp <= reactionMinutes * 60000 and math.abs(level.lo - price) <= tolerance

f_yellow(Poi zone, array<Level> candidates, Reaction reaction, int now) =>
    bool higherRb = false
    bool reversal = not requireReaction
    for id in zone.memberIds
        Level member = array.get(candidates, id)
        if member.kind == 4
            int seconds = member.caption == "RB 15m" ? 900 : member.caption == "RB 10m" ? 600 : member.caption == "RB 5m" ? 300 : 0
            higherRb := higherRb or seconds >= timeframe.in_seconds(yellowRbTf)
        if member.kind == 3
            reversal := reversal or f_hasReaction(member, reaction, now)
    zone.kinds == 4 and higherRb and reversal

f_candidates(array<Level> source, array<Level> candidates, bool enabled) =>
    if enabled
        for level in source
            if level.active and not level.dead and (level.kind != 3 or level.caption == "VAH ~" or level.caption == "VAL ~")
                array.push(candidates, level)
    array.size(candidates)

// Prefer a fixed Fib price, then an already formed RB wick. With VP + VWAP,
// freeze the qualifying profile edge. Never anchor a resting zone to a moving
// average's new price on every candle.
f_anchorMember(Poi zone, array<Level> candidates) =>
    int selected = array.get(zone.memberIds, 0)
    int bestRank = 99
    float closest = na
    float middle = (zone.lo + zone.hi) / 2
    for id in zone.memberIds
        Level member = array.get(candidates, id)
        int rank = member.kind == 1 ? 0 : member.kind == 4 ? 1 : member.kind == 3 ? 2 : 3
        float distance = math.abs((member.lo + member.hi) / 2 - middle)
        if rank < bestRank or (rank == bestRank and (na(closest) or distance < closest))
            selected := id
            bestRank := rank
            closest := distance
    array.get(candidates, selected)

f_anchorKey(Level anchor) =>
    "|" + str.tostring(anchor.kind) + ":" + anchor.caption + ":" + str.tostring(anchor.epoch) + "|"

// Confluence CREATES a resting price area. It does not have to keep following
// VWAP / profile to stay on the chart. Only a price breach (or optional expiry)
// retires it. Each anchor is consumed once, including after invalidation.
f_updateZones(array<ZoneRecord> records, array<Level> candidates, Reaction reaction, int now, float reference) =>
    bool changed = false
    array<Poi> current = f_findPois(candidates, reference)
    for record in records
        bool expired = zoneMaxDays > 0 and now - record.start >= zoneMaxDays * DAY_MS
        bool breached = record.side == 1 ? high >= record.killHi : low <= record.killLo
        if record.live and record.start < now and (breached or expired)
            record.live := false
            record.finish := now
            changed := true
    for zone in current
        Level anchor = f_anchorMember(zone, candidates)
        string key = f_anchorKey(anchor)
        float anchorPrice = anchor.kind == 4 ? math.max(anchor.lo, math.min(anchor.hi, (zone.lo + zone.hi) / 2)) : (anchor.lo + anchor.hi) / 2
        float rawLo = math.min(anchor.lo, zone.lo)
        float rawHi = math.max(anchor.hi, zone.hi)
        float middle = zoneSizing == "Fixed height" ? anchorPrice : (rawLo + rawHi) / 2
        float height = zoneSizing == "Fixed height" ? minimumHeight : math.max(minimumHeight, rawHi - rawLo)
        float bottom = math.floor((middle - height / 2 - boxPadding) / syminfo.mintick) * syminfo.mintick
        float top = math.ceil((middle + height / 2 + boxPadding) / syminfo.mintick) * syminfo.mintick
        bool yellow = f_yellow(zone, candidates, reaction, now)
        int found = -1
        float closest = na
        bool consumed = false
        if array.size(records) > 0
            for i = 0 to array.size(records) - 1
                ZoneRecord record = array.get(records, i)
                bool sameAnchor = str.contains(record.anchors, key)
                consumed := consumed or sameAnchor
                float distance = math.abs(middle - (record.lo + record.hi) / 2)
                bool nearby = anchorPrice >= record.lo - mergeDistance and anchorPrice <= record.hi + mergeDistance
                if record.live and (sameAnchor or nearby) and (na(closest) or sameAnchor or distance < closest)
                    found := i
                    closest := sameAnchor ? -1.0 : distance
        if found >= 0
            ZoneRecord record = array.get(records, found)
            if not str.contains(record.anchors, key)
                record.anchors += key
            bool nearby = anchorPrice >= record.lo - mergeDistance and anchorPrice <= record.hi + mergeDistance
            if nearby
                record.lastSeen := now
                if zone.kinds > record.kinds
                    record.kinds := zone.kinds
                    changed := true
                if yellow and not record.yellow
                    record.yellow := true
                    record.yellowAt := now
                    changed := true
        if found < 0 and not consumed
            int side = anchor.side
            array.push(records, ZoneRecord.new(now, now, bottom, top, zone.kinds, yellow, true, now, side, key, anchor.lo - invalidation, anchor.hi + invalidation, yellow ? now : na))
            changed := true
    int index = array.size(records) - 1
    while index >= 0
        ZoneRecord record = array.get(records, index)
        if not record.live and record.finish < now - zoneDays * DAY_MS
            array.remove(records, index)
            changed := true
        index -= 1
    while array.size(records) > zoneLimit
        array.shift(records)
        changed := true
    changed
